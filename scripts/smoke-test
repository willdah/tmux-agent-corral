#!/usr/bin/env bash
# smoke-test: drives agent-state and agents on a throwaway tmux server loaded
# with agents.tmux and the README's status snippet, and checks the panel,
# status line and tabs.
set -euo pipefail

here="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
proj="$tmp/smokeproj"; mkdir "$proj"   # not a git repo: the project is the directory
conf="$tmp/tmux.conf"
cat >"$conf" <<CONF
set -g base-index 1
setw -g pane-base-index 1
source-file "$here/agents.tmux"
set -g @agents_notify off   # the notify checks turn it on
set -ag status-right "#{E:@agents_status}"
setw -ag window-status-format "#{E:@agent_tab}"
CONF
sock="agents-smoke-$$"
t() { tmux -L "$sock" -f "$conf" "$@"; }
trap 't kill-server 2>/dev/null || true; rm -rf "$tmp"' EXIT
fail() { printf 'FAIL %s\n' "$*" >&2; exit 1; }

cd "$proj"
t new-session -d -s work -x 160 -y 40 'sleep 600' \; \
  split-window 'sleep 600' \; new-window 'sleep 600' \; \
  new-session -d -s side 'sleep 600' \; new-window -t side:
TMUX="$(t display -p '#{socket_path}'),0,0"; export TMUX
id() { t display -p -t "$1" '#{pane_id}'; }
a=$(id work:1.1) b=$(id work:1.2) c=$(id work:2.1) d=$(id side:1.1) shell=$(id side:2.1)

TMUX_PANE=$a "$here/src/agent-state" running </dev/null
TMUX_PANE=$b "$here/src/agent-state" input   </dev/null
TMUX_PANE=$c "$here/src/agent-state" done    </dev/null
TMUX_PANE=$d "$here/src/agent-state" input   </dev/null
TMUX_PANE=$shell "$here/src/agent-state" running </dev/null   # bare shell: stale

since="$(t display -p -t "$b" '#{@agent_since}')"
sleep 1; TMUX_PANE=$b "$here/src/agent-state" input </dev/null
[ "$(t display -p -t "$b" '#{@agent_since}')" = "$since" ] || fail "repeat state reset @agent_since"

# listen: start a waiter on the agents channel ($w) that is really waiting,
# not returning at once on a signal an earlier call left pending.
listen() {
  while :; do
    t wait-for agents & w=$!; sleep 0.3
    kill -0 "$w" 2>/dev/null && return 0
  done
}

# A change wakes the panel's waiter on the agents channel.
listen
TMUX_PANE=$a "$here/src/agent-state" idle </dev/null; sleep 0.3
kill -0 "$w" 2>/dev/null && { kill "$w"; fail "agent-state did not signal the agents channel"; }
TMUX_PANE=$a "$here/src/agent-state" running </dev/null

# The list only reads: a stale pane stays until sweep clears every field of
# it, and only of panes back at a bare shell. A shell with something running
# under it (a wrapper) is a live agent.
"$here/src/agents" --rows | grep -q "	$shell	" || fail "rows hid a stale pane before any sweep"
wrap="$(t new-window -d -P -F '#{pane_id}' -t side: "bash -c 'sleep 600'")"
TMUX_PANE=$wrap "$here/src/agent-state" running </dev/null
t set -p -t "$shell" @agent_dir /x \; set -p -t "$shell" @agent_project y \; set -p -t "$shell" @agent_name z
# Bare means no child: wait out the shell's startup (Ubuntu's bashrc runs
# lesspipe and dircolors), which sweep would rightly take for a wrapper's.
sp="$(t display -p -t "$shell" '#{pane_pid}')"
for _ in $(seq 50); do pgrep -P "$sp" >/dev/null || break; sleep 0.1; done
"$here/src/agent-state" sweep
f='#{@agent}#{@agent_state}#{@agent_since}#{@agent_name}#{@agent_dir}#{@agent_project}'
[ -z "$(t display -p -t "$shell" "$f")" ] || fail "sweep left state on the stale shell pane: $(t display -p -t "$shell" "$f|#{pane_current_command}|#{pane_pid}"); its children: $(pgrep -lP "$sp" | tr '\n' ' ')"
[ "$(t display -p -t "$a" '#{@agent_state}')" = running ] || fail "sweep cleared a live agent"
[ "$(t display -p -t "$wrap" '#{@agent_state}')" = running ] || fail "sweep cleared a wrapper shell with a child"
t kill-pane -t "$wrap"
# --rows: eight tab-separated fields per agent, rank and since leading.
r="$("$here/src/agents" --rows | grep "	$b	")"
[ "$(printf '%s' "$r" | awk -F'\t' '{print NF, $1, $2, $3, $4, $5, $6, $7, $8}')" = "8 0 $since $b input claude smokeproj work work" ] || fail "rows record: $r"
order="$("$here/src/agents" --rows | cut -f3 | tr '\n' ' ')"
case "$order" in "$b $d $c $a "|"$d $b $c $a ") ;; *) fail "order: $order" ;; esac
# Grouped: a heading per session, the session with the most urgent row first
# (b and d wait from the same second, so either), each in the usual order; an untitled row names its directory, not the
# session its heading shows.
t set -g @agents_group off; "$here/src/agents" --group
[ "$(t show -gv @agents_group)" = on ] || fail "--group did not turn grouping on"
order="$("$here/src/agents" --rows | cut -f3 | tr '\n' ' ')"
case "$order" in "-work $b $c $a -side $d "|"-side $d -work $b $c $a ") ;; *) fail "grouped order: $order" ;; esac
r="$("$here/src/agents" --rows | awk -F'\t' '$3 == "-work" { print NF, $1, $4, $8 }')"
[ "$r" = '8 H 1 1 0 1 work' ] || fail "heading record: $r"
h="$(NO_COLOR=1 FZF_COLUMNS=42 "$here/src/agents" --list | grep '^-work' | cut -f2)"
[ "$h" = $' \e[1mwork\e[22m ──────────────────── ▲1 ✓1 ●1' ] || fail "group heading: $h"   # bold stays under NO_COLOR
h="$(NO_COLOR=1 FZF_COLUMNS=64 "$here/src/agents" --list | grep '^-work' | cut -f2 | sed $'s/\e\\[[0-9]*m//g')"
[ "${#h}" -le 57 ] || fail "group heading wider than the 64-column dock: $h"
NO_COLOR=1 FZF_COLUMNS=12 "$here/src/agents" --list >/dev/null || fail "grouped list failed on a narrow panel"
# The panel's list: NUL-separated, a blank line opening every heading but the first.
gaps="$("$here/src/agents" --list0 | tr '\0' '\036' | tr -cd '\036\n' | tr '\036' .)"
case "$gaps" in $'....\n..'|$'..\n....') ;; *) fail "group gaps: $(printf %q "$gaps")" ;; esac
# A heading is no pane: every action leaves it alone.
for f in --jump --approve --interrupt --rename; do
  "$here/src/agents" "$f" -work </dev/null >/dev/null || fail "$f on a heading"
done
NO_COLOR=1 "$here/src/agents" --list | grep "^$a" | grep -q '●  smokeproj' || fail "grouped untitled row"
[ "$("$here/src/agents" --list | grep '^-work' | cut -f3)" = work ] || fail "heading's hidden name field"
h="$(NO_COLOR=1 FZF_COLUMNS=14 "$here/src/agents" --list | grep '^-work' | cut -f2 | sed $'s/\e\\[[0-9]*m//g')"
[ "${#h}" -le 7 ] || fail "group heading wider than the panel: $h"
t set -g @agents_group on; "$here/src/agents" --group
[ "$(t show -gv @agents_group)" = off ] || fail "--group did not turn grouping off"
t select-pane -t "$b" -T '✳ Fix login'
"$here/src/agents" --list | grep "^$b" | grep -q 'mFix login' || fail "title not shown"
"$here/src/agents" --list | grep "^$a" | grep -q 'mwork ' || fail "untitled row lost its place"
"$here/src/agents" --list | grep "^$a" | grep -q 'msmokeproj ' || fail "project column"
[ -z "$(t display -p -t "$a" '#{@agent_dir}#{@agent_project}')" ] || fail "a failed git lookup was cached"
# A repo and its worktree both show as the repo, and the answer is cached.
g() { git -C "$tmp/repo" -c user.name=t -c user.email=t@t -c commit.gpgsign=false "$@"; }
git init -q "$tmp/repo"; g commit -q --allow-empty -m init; g worktree add -q "$tmp/wt" 2>/dev/null
qs=
for dir in "$tmp/repo" "$tmp/wt"; do
  q="$(t new-window -d -P -F '#{pane_id}' -t side: -c "$dir" 'sleep 600')"; qs="$qs $q"
  TMUX_PANE=$q "$here/src/agent-state" idle </dev/null
  "$here/src/agents" --list | grep "^$q" | grep -q 'mrepo ' || fail "project for $dir"
  [ "$(t display -p -t "$q" '#{@agent_project}')" = repo ] || fail "project not cached for $dir"
done
t set -p -t "$q" @agent_project cached
"$here/src/agents" --list | grep "^$q" | grep -q 'mcached ' || fail "project cache not used"
t set -p -t "$q" @agent_dir /elsewhere   # as if the agent had moved here from there
"$here/src/agents" --list | grep "^$q" | grep -q 'mrepo ' || fail "project cache not refreshed on a new directory"
for q in $qs; do TMUX_PANE=$q "$here/src/agent-state" clear </dev/null; done
plain="$(NO_COLOR=1 "$here/src/agents" --list)"
case "$plain" in *$'\033'*) fail "NO_COLOR left colour codes in" ;; esac
printf '%s\n' "$plain" | grep "^$b" | grep -q '▲  Fix login' || fail "NO_COLOR row"
# A colour is any of tmux's: colourN, #rrggbb, or one of the 16 names; one
# the panel can't place falls back to the default.
for col in 'colour196 38;5;196' '#ff8000 38;2;255;128;0' 'red 38;5;1' 'brightred 38;5;9' 'nonsense 38;5;214'; do
  t set -g @agent_c_input "${col% *}"
  "$here/src/agents" --list | grep "^$b" | grep -qF $'\033'"[${col#* }m" || fail "@agent_c_input ${col% *} not shown as ${col#* }"
done
t set -g @agent_c_border '#102030' \; set -g @agents_group on   # the group rule is in it
"$here/src/agents" --list | grep -F $'\033[38;2;16;32;48m' >/dev/null || fail "@agent_c_border not used"
t set -g @agents_group off
t set -g @agent_c_input colour214 \; set -gu @agent_c_border \; source-file "$here/agents.tmux"
# The summary box heads the panel, so the list is rows only.
NO_COLOR=1 "$here/src/agents" --list | sed -n 1p | grep -q '^%' || fail "list opens with something other than a row"
NO_COLOR=1 FZF_COLUMNS=42 "$here/src/agents" --list >/dev/null || fail "narrow list failed"
while IFS=$'\t' read -r _ row _; do
  row="$(printf '%s' "$row" | sed $'s/\033\\[[0-9;]*m//g')"
  [ "${#row}" -le 57 ] || fail "row wider than the 64-column dock: $row"
done < <(FZF_COLUMNS=64 "$here/src/agents" --list)
while IFS=$'\t' read -r _ row _; do
  row="$(printf '%s' "$row" | sed $'s/\033\\[[0-9;]*m//g')"
  case "$row" in *smokeproj*|*PROJECT*) fail "narrow row kept the project: $row" ;; esac
  [ "${#row}" -le 35 ] || fail "row wider than a 42-column panel: $row"
done < <(FZF_COLUMNS=42 "$here/src/agents" --list)
"$here/src/agents" --rename "$b" 'Login → OAuth'
"$here/src/agents" --list | grep "^$b" | grep -q 'mLogin → OAuth ' || fail "rename not shown"
"$here/src/agents" --rename "$b"
"$here/src/agents" --list | grep "^$b" | grep -q 'mFix login' || fail "empty rename did not reset"
# The inline fields, as fzf drives them through --key. n pre-fills the row's
# full name, the list's hidden third field; ↵ on it untouched must not freeze
# the title as a name.
k() { FZF_PROMPT="$1" FZF_QUERY="${2:-}" AGENTS_ENTER=jump AGENTS_FOOTER=keys \
  AGENTS_M=open-m AGENTS_N=open-n AGENTS_D=open-d "$here/src/agents" --key "${@:3}"; }
shown="$("$here/src/agents" --list | grep "^$b" | cut -f3)"; [ "$shown" = "Fix login" ] || fail "hidden name field: $shown"
[ "$(k '⌕ ' '' m "$b")" = open-m ] && [ "$(k '⌕ ' '' n "$b")" = open-n ] || fail "m/n did not open on an agent"
[ -z "$(k '⌕ ' '' m -work)" ] || fail "m opened on a heading"
[ "$(k '⌕ ' '' n -work)" = open-n ] || fail "n did not open on a heading"
# n on a heading renames its tmux session; it can't go nameless or take a name in use.
t new-session -d -s tmp 'sleep 600'
[ "$(k 'rename tmp › ' tmp enter -tmp tmp)" = change-footer:keys ] || fail "untouched session rename did something"
[ "$(k 'rename tmp › ' '' enter -tmp tmp)" = change-footer:keys ] || fail "empty session rename did something"
k 'rename tmp › ' side enter -tmp tmp | grep -q 'not renamed: .*duplicate' || fail "session renamed onto a taken name"
k 'rename tmp › ' tmp2 enter -tmp tmp | grep -q 'renamed to .*tmp2' || fail "session rename footer"
t has-session -t =tmp2 || fail "session not renamed"
k 'rename tmp › ' x enter -tmp tmp | grep -q 'not renamed' || fail "rename of a gone session claimed success"
t has-session -t =x 2>/dev/null && fail "rename of a gone session renamed another"
t kill-session -t =tmp2
k '⌕ ' '' message "$(printf '%030d' 0)" | grep -q '^message to 0\{23\}… › $' || fail "long name not cut in the prompt"
[ "$(k 'rename X › ' '' rename X)" = 'rename X › ' ] || fail "rename prompt"
[ "$(k 'rename Fix login › ' 'Fix login' enter "$b" 'Fix login')" = change-footer:keys ] || fail "untouched rename did something"
[ -z "$(t show -pv -t "$b" @agent_name 2>/dev/null)" ] || fail "untouched rename froze the title"
k 'rename Fix login › ' 'Fix it' enter "$b" 'Fix login' | grep -q 'renamed to .*Fix it' || fail "rename footer"
[ "$(t show -pv -t "$b" @agent_name)" = 'Fix it' ] || fail "inline rename not set"
k 'rename Fix it › ' '' enter "$b" 'Fix it' | grep -q 'name reset' || fail "reset footer"
[ -z "$(t show -pv -t "$b" @agent_name 2>/dev/null)" ] || fail "inline reset kept the name"
mp="$(t new-window -d -P -F '#{pane_id}' -t side: cat)"
k 'message to cat › ' 'hi; -x )' enter "$mp" cat | grep -q 'sent to .*cat' || fail "message footer"
sleep 0.3; t capture-pane -p -t "$mp" | grep -qF 'hi; -x )' || fail "message not typed"
[ "$(k 'message to cat › ' '' enter "$mp" cat)" = change-footer:keys ] || fail "empty message did something"
t kill-pane -t "$mp"
k 'message to cat › ' hi enter "$mp" cat | grep -q 'not sent: .*cat.* is gone' || fail "message to a gone pane claimed success"
k 'rename cat › ' x enter "$mp" cat | grep -q 'not renamed' || fail "rename of a gone pane claimed success"
# d asks in the footer, on an agent's row only; ↵ kills the pane, esc keeps it.
[ "$(k '⌕ ' '' d "$b")" = open-d ] && [ -z "$(k '⌕ ' '' d -work)" ] || fail "d opened on a heading, or not on an agent"
k '⌕ ' '' kill "$(printf '%030d' 0)" | grep -q 'kill 0\{23\}…?' || fail "kill question"
alive() { t list-panes -a -F '#{pane_id}' | grep -qx "$1"; }
kp="$(t new-window -d -P -F '#{pane_id}' -t side: 'sleep 600')"
[ "$(k 'kill › ' '' esc)" = change-footer:keys ] && alive "$kp" || fail "esc on kill closed the panel or the pane"
k 'kill › ' '' enter "$kp" sleeper | grep -q 'killed .*sleeper' || fail "kill footer"
alive "$kp" && fail "pane not killed"
k 'kill › ' '' enter "$kp" sleeper | grep -q 'not killed: .*sleeper.* is gone' || fail "kill of a gone pane claimed success"
[ "$(k '⌕ ' '' enter "$b")" = jump ] && [ "$(k '⌕ ' '' esc)" = abort ] || fail "↵/esc outside a field"
[ "$(FZF_INPUT_STATE=enabled k '⌕ ' do esc)" = change-footer:keys ] || fail "esc in the filter closed the panel"
[ "$(k 'message to X › ' '' esc)" = change-footer:keys ] || fail "esc in a field closed the panel"
[ "$(k '⌕ ' '' reload)" = "reload-sync($here/src/agents --list0)" ] || fail "reload outside a field"
[ -z "$(k 'rename X › ' '' reload)$(k 'rename X › ' '' restore)" ] || fail "reload/restore touched an open field"
# / opens the filter, locking the action keys; a quick second / clears it,
# then key shut closes it, once. A slow /, or one in a field, types.
mkdir "$tmp/st"
ks() { AGENTS_STATE="$tmp/st" AGENTS_LOCK=y,x FZF_INPUT_STATE="$1" FZF_PROMPT="$2" "$here/src/agents" --key "${@:3}"; }
[ "$(ks hidden '⌕ ' slash)" = 'unbind(y,x)+change-input-label( filter )+show-input' ] || fail "/ did not open the filter"
[ "$(ks enabled '⌕ ' slash)" = 'change-query()' ] || fail "// did not clear the filter"
[ "$(ks enabled '⌕ ' shut)" = 'hide-input+rebind(y,x)+search()' ] || fail "// did not close the filter"
[ -z "$(ks hidden '⌕ ' shut)" ] || fail "the filter closed twice"
sleep 0.5; [ "$(ks enabled '⌕ ' slash)" = 'put(/)' ] || fail "a slow / did not type"
[ "$(ks enabled 'message to X › ' slash)" = 'put(/)' ] || fail "/ in a field did not type"
# Other harnesses: the name shows, the title they give themselves doesn't.
TMUX_PANE=$c "$here/src/agent-state" running copilot </dev/null
t select-pane -t "$c" -T 'GitHub Copilot'
"$here/src/agents" --list | grep "^$c" | grep -q 'mwork .*copilot' || fail "copilot row"
TMUX_PANE=$c "$here/src/agent-state" done pi </dev/null
t select-pane -t "$c" -T "π - $(basename "$(t display -p -t "$c" '#{pane_current_path}')")"
"$here/src/agents" --list | grep "^$c" | grep -q 'mwork .*pi' || fail "pi row"
# Every row lays out the same columns, whatever its harness, and the caps
# hold on a wide panel. Widths are pinned: unset, they follow the terminal.
L() { NO_COLOR=1 FZF_COLUMNS="$1" "$here/src/agents" --list; }
wide="$(L 200)" || fail "wide list failed"
col() { printf '%s\n' "$wide" | grep "^$1" | cut -f2 | awk -v s=" $2 " '{print index($0, s)}'; }
[ "$(col "$c" pi)" -gt 0 ] && [ "$(col "$c" pi)" = "$(col "$a" claude)" ] ||
  fail "agent column moved: $(col "$c" pi) vs $(col "$a" claude)"
L 64 | grep "^$a" | grep -q ' claude ' && fail "agent column in the 64-column dock"
L 65 | grep "^$a" | grep -q ' claude ' || fail "no agent column on a 65-column panel"
L 64 | grep "^$a" | grep -q smokeproj || fail "the dock lost the project column"
# A group heading is as wide as the rows, not the panel.
t set -g @agents_group on
for W in 64 200; do
  out="$(L "$W")"
  h="$(printf '%s\n' "$out" | grep '^-work' | cut -f2 | sed $'s/\e\\[[0-9]*m//g')" r="$(printf '%s\n' "$out" | grep "^$a" | cut -f2)"
  [ "${#h}" = "${#r}" ] || fail "heading ${#h} wide, rows ${#r}, at $W"
done
t set -g @agents_group off

status="$(t display -p -t "$a" '#{E:status-right}')"
case "$status" in *'▲▲'*'●'*'✓'*) ;; *) fail "status-right: $status" ;; esac
case "$status" in *colour214*colour110*colour108*) ;; *) fail "status colours: $status" ;; esac
t set -g @agent_c_input '#ff8000' \; set -g @agent_c_running brightblue
status="$(t display -p -t "$a" '#{E:status-right}')"
case "$status" in *'fg=#ff8000'*'fg=brightblue'*) ;; *) fail "status colours by hex and name: $status" ;; esac
# A bare index, the old default, is upgraded as agents.tmux is read again.
t set -g @agent_c_input 214 \; set -g @agent_c_running colour110 \; source-file "$here/agents.tmux"
[ "$(t show -gv @agent_c_input)" = colour214 ] || fail "bare colour index not upgraded: $(t show -gv @agent_c_input)"
tab="$(t display -p -t "$a" '#{E:window-status-format}')"
case "$tab" in *'▲'*) ;; *) fail "tab: $tab" ;; esac   # marks run in pane order
case "$tab" in *'●'*) ;; *) fail "tab: $tab" ;; esac

t set -p -t "$c" @agent_name x
TMUX_PANE=$c "$here/src/agent-state" clear </dev/null
[ -z "$(t display -p -t "$c" '#{@agent_state}#{@agent_name}#{@agent_dir}#{@agent_project}')" ] || fail "clear left state behind"

# Docked panel: follows windows and sessions, and every window it leaves gets
# its exact layout back. The hooks call `follow`; with no client attached here
# they never fire, so the test calls it the same way.
t show-hooks -g session-window-changed | grep -q agents-dock || fail "follow hook missing"
t show-hooks -g client-session-changed | grep -q agents-dock || fail "session hook missing"
t show-hooks -g 'pane-focus-in[41]' | grep -q 'agents --ping' || fail "focus-in title hook missing"
t show-hooks -g 'pane-focus-out[40]' | grep -q 'agents --ping' || fail "focus-out title hook missing"
wid() { t display -p -t "$1" '#{window_id}'; }
geo() { t list-panes -t "$1" -F '#{pane_id}@#{pane_left}:#{pane_width}' | sort | tr '\n' ' '; }
w1=$(wid work:1) w2=$(wid work:2) s1=$(wid side:1)
g1=$(geo "$w1") g2=$(geo "$w2") gs=$(geo "$s1")

# The panel's refresh loops (fzf's own command line names them too), told
# apart from any real panel's by a before/after diff.
waiters() { pgrep -f 'while tmux wait-for agents' | sort || true; }
before="$(waiters)"
TMUX_PANE=$shell "$here/src/agent-state" running </dev/null   # stale again: the panel sweeps on open
"$here/src/agents-dock" toggle "$w1"
p="$(t show -gv @agents_dock)"
[ "$(t display -p -t "$p" '#{window_id}:#{pane_left}')" = "$w1:0" ] || fail "dock not on the left of work:1"
[ "$(t display -p -t "$p" '#{pane_active}')" = 1 ] || fail "docking did not focus the panel"
# A state change shows at once, well inside the 10s tick.
sleep 1.5
[ -z "$(t display -p -t "$shell" '#{@agent_state}')" ] || fail "the panel did not sweep on open"
TMUX_PANE=$shell "$here/src/agent-state" running </dev/null   # and on every 10s tick
sleep 11
[ -z "$(t display -p -t "$shell" '#{@agent_state}')" ] || fail "the panel's tick did not sweep"
n="$(t capture-pane -p -t "$p" | grep -c '▲')"
TMUX_PANE=$a "$here/src/agent-state" input </dev/null; sleep 1
[ "$(t capture-pane -p -t "$p" | grep -c '▲')" -gt "$n" ] || fail "panel did not reload on a state change"
TMUX_PANE=$a "$here/src/agent-state" running </dev/null
mine="$(comm -13 <(printf '%s\n' "$before") <(waiters))"
[ -n "$mine" ] || fail "panel has no refresh loop"
t resize-pane -t "$p" -x 50
for w in "$w2" "$s1" "$w1"; do "$here/src/agents-dock" follow "$w"; done
[ "$(t display -p -t "$p" '#{window_id}')" = "$w1" ] || fail "dock did not follow back to work:1"
[ "$(t display -p -t "$p" '#{pane_width}')" = 50 ] || fail "dock lost its resized width: $(t display -p -t "$p" '#{pane_width}')"
[ "$(geo "$w2")" = "$g2" ] || fail "work:2 layout not restored: $(geo "$w2")"
[ "$(geo "$s1")" = "$gs" ] || fail "side:1 layout not restored: $(geo "$s1")"

# q after a reload closes it (fzf hung on --track with an empty row id).
sleep 1; t wait-for -S agents; sleep 1; t send-keys -t "$p" q; sleep 1
t list-panes -a -F '#{pane_id}' | grep -qx -- "$p" && fail "q did not close the docked panel"
[ "$(geo "$w1")" = "$g1" ] || fail "work:1 layout not restored after q: $(geo "$w1")"
gone() { for w in $mine; do kill -0 "$w" 2>/dev/null && fail "$1 left refresh loop $w running"; done; return 0; }
gone q
# Undocking kills the pane, so the panel never sends its parting signal.
"$here/src/agents-dock" toggle "$w1"; sleep 1.5
mine="$(comm -13 <(printf '%s\n' "$before") <(waiters))"
"$here/src/agents-dock" toggle "$w1"; sleep 0.5
gone undocking

# The docked panel's title, atop the summary, is bold while it has focus and
# plain once it goes. The focus hooks need a client, so ping by hand.
t select-window -t "$w1"; "$here/src/agents-dock" toggle "$w1"; p="$(t show -gv @agents_dock)"; sleep 1.5
title() { t capture-pane -ep -t "$p" | sed -n 1p; }
lit() { title | grep -q $'\e\\[1m'; }   # only a lit title is bold on that line
lit || fail "focused panel's title not marked: $(title)"
# The ping marks it; the panel's next tick (0.2s) redraws it.
t last-pane -t "$w1"; "$here/src/agents" --ping; sleep 0.5
lit && fail "unfocused panel's title still marked: $(title)"
t select-pane -t "$p"; "$here/src/agents" --ping; sleep 0.5
lit || fail "refocused panel's title not marked: $(title)"
# The summary counts the agents; the list under it shows them.
t capture-pane -p -t "$p" | grep -q 'need you' || fail "no summary in the docked panel: $(t capture-pane -p -t "$p")"
"$here/src/agents-dock" toggle "$w1"; sleep 0.5

# @agents_panel_key_<action> moves a panel key, footer hint and all; empty
# unbinds it.
t set -g @agents_panel_key_preview P \; set -g @agents_panel_key_kill '' \; set -g @agents_panel_key_group G
"$here/src/agents-dock" toggle "$w1"; p="$(t show -gv @agents_dock)"; sleep 1.5
foot="$(t capture-pane -p -t "$p")"   # the hints sit above the peek
grep -q 'P peek' <<<"$foot" || fail "moved key not in the footer: $foot"
grep -q 'kill' <<<"$foot" && fail "unbound key still in the footer: $foot"
grp="$(t show -gv @agents_group)"
t send-keys -t "$p" g; sleep 0.5
[ "$(t show -gv @agents_group)" = "$grp" ] || fail "g still groups after moving to G"
t send-keys -t "$p" G; sleep 0.5
[ "$(t show -gv @agents_group)" != "$grp" ] || fail "G did not group"
t send-keys -t "$p" G; sleep 0.5
"$here/src/agents-dock" toggle "$w1"; sleep 0.5
t set -gu @agents_panel_key_preview \; set -gu @agents_panel_key_kill \; set -gu @agents_panel_key_group

# Enter in the docked panel: the panel follows to the agent's window and keeps
# focus, the agent is that window's last pane, and a finished one reads seen.
# switch-client needs a client, so attach a control-mode one. Its hooks would
# call the installed copy, so drop them until the end: the jump calls follow
# itself.
t set-hook -gu 'session-window-changed[40]' \; set-hook -gu 'client-session-changed[40]'
{ echo 'refresh-client -C 160x40'; sleep 30; } | t -C attach -t work:1 >/dev/null & cc=$!
for _ in $(seq 50); do t list-clients | grep -q . && break; sleep 0.1; done
"$here/src/agents-dock" toggle "$w1"; p="$(t show -gv @agents_dock)"
TMUX_PANE=$c "$here/src/agent-state" done </dev/null
landed() { [ "$(t display -p '#{window_id}')" = "$(wid "$1")" ] || fail "$2 did not show the agent"; }
"$here/src/agents" --jump "$c" stay
landed "$c" "jump"
[ "$(t display -p -t "$p" '#{window_id}:#{pane_active}')" = "$w2:1" ] || fail "jump did not keep focus in the docked panel"
[ "$(t display -p -t "$c" '#{pane_last}')" = 1 ] || fail "jump did not make the agent its window's last pane"
[ "$(t display -p -t "$c" '#{@agent_state}')" = idle ] || fail "jump did not mark a finished agent seen"
[ "$(geo "$w1")" = "$g1" ] || fail "work:1 layout not restored after a jump: $(geo "$w1")"
# Beside the panel there is nothing to move, but the jump still lands.
t switch-client -t "$w1"; TMUX_PANE=$c "$here/src/agent-state" done </dev/null
"$here/src/agents" --jump "$c" stay
landed "$c" "jump beside the panel"
[ "$(t display -p -t "$p" '#{pane_active}')" = 1 ] || fail "jump beside the panel took its focus"
[ "$(t display -p -t "$c" '#{@agent_state}')" = idle ] || fail "jump beside the panel did not mark the agent seen"
# Into a window too narrow to share, the panel stays put.
n="$(t new-window -d -P -F '#{pane_id}' -t work: 'sleep 600')"; t resize-window -t "$n" -x 100
"$here/src/agents" --jump "$n" stay
landed "$n" "jump into a narrow window"
[ "$(t display -p -t "$p" '#{window_id}')" = "$w2" ] || fail "the panel followed into a narrow window"
t kill-pane -t "$n"
# A window the client has not shown yet keeps its old size until it is (80
# columns in a session nobody has been on), so the jump judges by the
# client's width, and the panel follows. Only a window sized by hand, like
# the narrow one above, keeps its own.
[ "$(t display -p -t "$d" '#{window_width}')" = 80 ] || fail "side is not at its unvisited size"
"$here/src/agents" --jump "$d" stay
landed "$d" "jump into an unvisited session"
[ "$(t display -p -t "$p" '#{window_id}:#{pane_active}')" = "$(wid "$d"):1" ] || fail "jump into an unvisited session lost the panel"
[ "$(t display -p -t "$p" '#{pane_width}')" = 64 ] || fail "panel not 64 wide after the window took the client's size: $(t display -p -t "$p" '#{pane_width}')"
# Into a zoomed window the panel can't follow, so the agent gets focus.
"$here/src/agents-dock" toggle "$w2"; "$here/src/agents-dock" toggle "$w1"; p="$(t show -gv @agents_dock)"
z="$(t split-window -d -P -F '#{pane_id}' -t "$c" 'sleep 600')"; t resize-pane -Z -t "$c"
t switch-client -t "$w1"; TMUX_PANE=$c "$here/src/agent-state" done </dev/null
"$here/src/agents" --jump "$c" stay
landed "$c" "jump into a zoomed window"
[ "$(t display -p -t "$p" '#{window_id}')" = "$w1" ] || fail "the panel followed into a zoomed window"
[ "$(t display -p -t "$c" '#{pane_active}#{window_zoomed_flag}')" = 11 ] || fail "jump into a zoomed window did not focus the agent"
[ "$(t display -p -t "$c" '#{@agent_state}')" = idle ] || fail "jump into a zoomed window did not mark the agent seen"
t kill-pane -t "$z"
# The popup's jump focuses the agent.
"$here/src/agents" --jump "$b"
[ "$(t display -p '#{pane_id}')" = "$b" ] || fail "popup jump did not focus the agent"
"$here/src/agents-dock" toggle "$w1"
# With nothing docked, the docked jump still lands.
t switch-client -t "$w1"; "$here/src/agents" --jump "$c" stay
landed "$c" "jump with no panel docked"
kill "$cc" 2>/dev/null || true
TMUX_PANE=$c "$here/src/agent-state" clear </dev/null
t source-file "$here/agents.tmux"

# Seeing a finished agent dims it, and wakes the panel: the hook calls
# agent-state seen. With no client the hook can't fire, so run its command on
# the current pane, pointed at this checkout rather than the installed one.
hook="$(t show-hooks -g 'pane-focus-in[40]' | sed 's/^[^ ]* //')"
hook="${hook//\~\/.config\/tmux\/agents/$here}"
cur="$(t display -p '#{pane_id}')"
t set -p -t "$cur" @agent_state done \; set -p -t "$cur" @agent_since 1234
listen
t run-shell -C "$hook"; sleep 0.5
[ "$(t display -p -t "$cur" '#{@agent_state} #{@agent_since}')" = 'idle 1234' ] || fail "focus did not dim a finished agent, or moved its clock"
kill -0 "$w" 2>/dev/null && { kill "$w"; fail "focus hook did not signal"; }
listen
t run-shell -C "$hook"; sleep 0.5   # idle now: no change, no signal
kill -0 "$w" 2>/dev/null || fail "focus hook signalled without a change"
kill "$w"; wait "$w" 2>/dev/null || true
t set -pu -t "$cur" @agent_state \; set -pu -t "$cur" @agent_since
# seen leaves a waiting agent, and a gone pane, alone.
"$here/src/agent-state" seen "$b" && [ "$(t display -p -t "$b" '#{@agent_state}')" = input ] || fail "seen touched a waiting agent"
"$here/src/agent-state" seen %999 || fail "seen on a gone pane failed"

# x: a working Copilot gets C-c once and reads idle, so a second x is refused
# (another C-c would quit it); any other agent gets Escape, and reads idle too.
cp="$(t new-window -d -P -F '#{pane_id}' -t side: "sh -c 'trap \"echo GOT_CC\" INT; while :; do sleep 0.2; done'")"
TMUX_PANE=$cp "$here/src/agent-state" running copilot </dev/null
"$here/src/agents" --interrupt "$cp"; sleep 0.5
[ "$(t display -p -t "$cp" '#{@agent_state}')" = idle ] || fail "copilot not idle after x"
"$here/src/agents" --interrupt "$cp"; sleep 0.5
[ "$(t capture-pane -p -t "$cp" | grep -c GOT_CC)" = 1 ] || fail "x did not send copilot exactly one C-c"
ec="$(t new-window -d -P -F '#{pane_id}' -t side: cat)"   # the tty echoes Escape as ^[
TMUX_PANE=$ec "$here/src/agent-state" running </dev/null
"$here/src/agents" --interrupt "$ec"; sleep 0.3
t capture-pane -p -t "$ec" | grep -qF '^[' || fail "x sent no Escape"
# Claude's Escape fires no hook either, so x marks it idle, harness kept, and
# a second x is refused.
[ "$(t display -p -t "$ec" '#{@agent_state} #{@agent}')" = 'idle claude' ] || fail "claude not idle after x"
"$here/src/agents" --interrupt "$ec"; sleep 0.3
[ "$(t capture-pane -p -t "$ec" | grep -o '\^\[' | wc -l | tr -d ' ')" = 1 ] || fail "x sent a second Escape to an idle agent"
for q in $cp $ec; do t kill-pane -t "$q"; done
grep -q sessionStart "$here/harnesses/copilot/hooks.json" && fail "copilot sessionStart hook is back: it fires after the first prompt"

# wait: returns once the pane is in a wanted state (input or done when none
# is named), 1 on the timeout or a pane that is gone.
TMUX_PANE=$a "$here/src/agent-state" running </dev/null
"$here/src/agent-state" wait "$a" done & wp=$!; sleep 0.3
kill -0 "$wp" 2>/dev/null || fail "wait returned before the state changed"
TMUX_PANE=$a "$here/src/agent-state" done </dev/null
for _ in $(seq 20); do kill -0 "$wp" 2>/dev/null || break; sleep 0.1; done
if wait "$wp"; then :; else fail "wait did not return 0 on done"; fi
"$here/src/agent-state" wait "$b" || fail "wait with no state did not take input"
"$here/src/agent-state" wait "$a" input --timeout 1 && fail "wait did not time out"
"$here/src/agent-state" wait %999 done && fail "wait did not fail on a missing pane"
"$here/src/agent-state" wait "$a" done --timeout x && fail "wait took a bad timeout"
# A caller reading wait's output is not held until the timeout.
TMUX_PANE=$a "$here/src/agent-state" running </dev/null
SECONDS=0; out="$("$here/src/agent-state" wait "$a" running --timeout 5)"
[ "$SECONDS" -lt 3 ] && [ -z "$out" ] || fail "wait held its output open for the timer"
# An agent that ends ends the wait, unless clear is what it waits for.
"$here/src/agent-state" wait "$a" done & wp=$!; sleep 0.3
TMUX_PANE=$a "$here/src/agent-state" clear </dev/null; sleep 0.3
kill -0 "$wp" 2>/dev/null && { kill "$wp"; fail "wait outlived its agent"; }
"$here/src/agent-state" wait "$a" clear || fail "wait clear on a gone agent"
TMUX_PANE=$a "$here/src/agent-state" running </dev/null
# prompt: types into a working agent; a pane that is no agent, or one waiting
# on you, is refused (the text would answer its question).
pc="$(t new-window -d -P -F '#{pane_id}' -t side: cat)"
"$here/src/agent-state" prompt "$pc" hello && fail "prompt accepted an untagged pane"
TMUX_PANE=$pc "$here/src/agent-state" input </dev/null
"$here/src/agent-state" prompt "$pc" hello && fail "prompt typed into a waiting agent"
TMUX_PANE=$pc "$here/src/agent-state" running </dev/null
"$here/src/agent-state" prompt "$pc" hello || fail "prompt refused a working agent"
sleep 0.3; t capture-pane -p -t "$pc" | grep -q '^hello$' || fail "prompt text not typed"
# A finished agent reads running once prompted, so a wait right after does
# not return on the old done; any tmux target works, and the name survives.
TMUX_PANE=$pc "$here/src/agent-state" done pi </dev/null
"$here/src/agent-state" prompt "$(t display -p -t "$pc" '#{session_name}:#{window_index}.#{pane_index}')" again || fail "prompt by target"
sleep 0.3; t capture-pane -p -t "$pc" | grep -q '^again$' || fail "prompt by target not typed"
[ "$(t display -p -t "$pc" '#{@agent_state} #{@agent}')" = 'running pi' ] || fail "prompt did not mark the agent running"
"$here/src/agent-state" wait "$pc" done --timeout 1 && fail "wait after prompt returned on the old done"
t kill-pane -t "$pc"
# notify: input and done call the notifier with the agent's name, unless a
# client is looking at that pane; running and idle never do; off is quiet.
nf="$tmp/notes"; printf '#!/bin/sh\necho "$1" >>"%s"\n' "$nf" >"$tmp/notify"; chmod +x "$tmp/notify"
t set -g @agents_notify "$tmp/notify"
{ echo 'refresh-client -C 160x40'; sleep 30; } | t -C attach -t work:1 >/dev/null & nc=$!
for _ in $(seq 50); do t list-clients | grep -q . && break; sleep 0.1; done
t select-pane -t "$a"
"$here/src/agents" --rename "$d" 'Side quest #{pane_id}'
TMUX_PANE=$d "$here/src/agent-state" running </dev/null; TMUX_PANE=$d "$here/src/agent-state" input </dev/null
TMUX_PANE=$a "$here/src/agent-state" done </dev/null   # the client is on this one
TMUX_PANE=$d "$here/src/agent-state" running </dev/null; TMUX_PANE=$d "$here/src/agent-state" idle </dev/null
TMUX_PANE=$d "$here/src/agent-state" done </dev/null; sleep 1
[ "$(LC_ALL=C sort "$nf")" = "$(printf '▲ Side quest #{pane_id} needs you\n✓ Side quest #{pane_id} finished\n' | LC_ALL=C sort)" ] || fail "notify: $(cat "$nf")"
t set -g @agents_notify off
TMUX_PANE=$d "$here/src/agent-state" input </dev/null; sleep 0.3
[ "$(wc -l <"$nf" | tr -d ' ')" = 2 ] || fail "notify off still notified"
t set -g @agents_notify tmux
TMUX_PANE=$d "$here/src/agent-state" done </dev/null || fail "notify tmux failed"
grep -q '^set -goq @agents_notify tmux' "$here/agents.tmux" || fail "agents.tmux default is not tmux"
# A setting made before agents.tmux is sourced survives it.
t set -g @agents_notify off \; source-file "$here/agents.tmux"
[ "$(t show -gv @agents_notify)" = off ] || fail "sourcing agents.tmux overwrote @agents_notify"
kill "$nc" 2>/dev/null || true
"$here/src/agents" --rename "$d"
TMUX_PANE=$a "$here/src/agent-state" running </dev/null

# agents-new: a session per agent, named after its folder, the command and
# prompt typed into its shell; in a repo, --branch makes or reuses a worktree
# from origin's default branch. The fake agents print what they were given.
t set -g default-shell /bin/sh
mkdir -p "$tmp/bin"
for f in claude copilot; do printf '#!/bin/sh\nprintf "ran:%s"; printf "[%%s]" "$@"; echo\nexec sleep 600\n' "$f" >"$tmp/bin/$f"; chmod +x "$tmp/bin/$f"; done
new() { "$here/src/agents-new" "$@"; }
said() { for _ in $(seq 30); do t capture-pane -p -t "$1" | grep -qF -- "$2" && return 0; sleep 0.1; done; fail "$1 never showed $2: $(t capture-pane -p -t "$1")"; }
P() { (cd -P "$1" && pwd); }
np="$(new --dir "$proj" --agent "$tmp/bin/claude" --prompt "it's \$HOME \"x\"")" || fail "agents-new failed"
said "$np" "ran:claude[--][it's \$HOME \"x\"]"
[ "$(t display -p -t "$np" '#{session_name}|#{pane_current_path}')" = "smokeproj|$(P "$proj")" ] || fail "new session: $(t display -p -t "$np" '#{session_name}|#{pane_current_path}')"
np2="$(new --dir "$proj" --agent "$tmp/bin/copilot" --prompt go)"
said "$np2" 'ran:copilot[-i][go]'
[ "$(t display -p -t "$np2" '#{session_name}')" = smokeproj-2 ] || fail "taken session name not bumped"
np3="$(new --dir "$proj" --agent "$tmp/bin/claude")"; said "$np3" 'ran:claude'
# --session adds a window, named after the folder, to a session there is,
# makes one there isn't; inside tmux the caller's session is the default.
nw="$(new --dir "$proj" --session side --agent "$tmp/bin/claude")"; said "$nw" 'ran:claude'
[ "$(t display -p -t "$nw" '#{session_name}|#{window_name}|#{pane_current_path}')" = "side|smokeproj|$(P "$proj")" ] || fail "window in a session: $(t display -p -t "$nw" '#{session_name}|#{window_name}')"
nw2="$(new --dir "$proj" --session peers --agent "$tmp/bin/claude")"
[ "$(t display -p -t "$nw2" '#{session_name}')" = peers ] || fail "named session not made"
nw3="$(TMUX_PANE=$a new --dir "$proj" --agent "$tmp/bin/claude")"
[ "$(t display -p -t "$nw3" '#{session_name}')" = work ] || fail "window not in the caller's session"
nw4="$(TMUX_PANE=$a new --dir "$proj" --session new --agent "$tmp/bin/claude")"
[ "$(t display -p -t "$nw4" '#{session_name}')" = smokeproj-4 ] || fail "--session new: $(t display -p -t "$nw4" '#{session_name}')"
for q in $nw $nw2 $nw3 $nw4; do t kill-pane -t "$q"; done
new --dir "$tmp/nowhere" --agent "$tmp/bin/claude" 2>/dev/null && fail "agents-new took a missing folder"
new --dir "$proj" --agent no-such-agent 2>/dev/null && fail "agents-new took a missing agent"
# A raw command can carry its own arguments.
nr="$(new --dir "$proj" --agent "$tmp/bin/claude --flag" --prompt go)" || fail "agents-new took no command with arguments"
said "$nr" 'ran:claude[--flag][--][go]'
# Launch profiles: @agents_launch_<name> is a command, its harness the first
# word naming one; empty hides one, as does a command not on PATH. The
# default leads, then its harness's others, then the other harnesses', then
# those of none.
printf '#!/bin/sh\nprintf "ran:aider"; printf "[%%s]" "$@"; echo\nexec sleep 600\n' >"$tmp/bin/aider"; chmod +x "$tmp/bin/aider"
t set -g @agents_launch_claude '' \; set -g @agents_launch_pi '' \
  \; set -g @agents_launch_copilot "$tmp/bin/copilot" \
  \; set -g @agents_launch_yolo "$tmp/bin/claude --yolo" \
  \; set -g @agents_launch_hr "env HR=1 $tmp/bin/copilot" \
  \; set -g @agents_launch_zz "$tmp/bin/aider --model claude" \
  \; set -g @agents_launch_gone "/no/such/claude" \
  \; set -g @agents_launch_default hr
want="hr	copilot	env HR=1 $tmp/bin/copilot
copilot	copilot	$tmp/bin/copilot
yolo	claude	$tmp/bin/claude --yolo
zz		$tmp/bin/aider --model claude"
[ "$(new --profiles)" = "$want" ] || fail "profiles: $(new --profiles)"
nr2="$(new --dir "$proj" --agent hr --prompt go)"; said "$nr2" 'ran:copilot[-i][go]'
nr3="$(new --dir "$proj" --agent zz --prompt go)"; said "$nr3" 'ran:aider[--model][claude][--][go]'   # an argument names no harness
nr4="$(new --dir "$proj" --prompt go)"; said "$nr4" 'ran:copilot[-i][go]'   # the default
new --dir "$proj" --agent gone 2>/dev/null && fail "agents-new took a profile not on PATH"
cp "$tmp/bin/aider" "$tmp/bin/pi"   # on PATH, so only hiding can refuse it
PATH="$tmp/bin:$PATH" new --dir "$proj" --agent pi 2>/dev/null && fail "agents-new started a hidden profile"
for o in claude pi copilot yolo hr zz gone default; do t set -gu "@agents_launch_$o"; done
t source-file "$here/agents.tmux"
for q in $nr $nr2 $nr3 $nr4; do t kill-pane -t "$q"; done
new --dir "$proj" --branch x --agent "$tmp/bin/claude" 2>/dev/null && fail "agents-new made a branch outside a repo"
git init -q "$tmp/up"; G() { git -C "$1" -c user.name=t -c user.email=t@t -c commit.gpgsign=false "${@:2}"; }
G "$tmp/up" commit -q --allow-empty -m up
git clone -q "$tmp/up" "$tmp/cl"; G "$tmp/cl" commit -q --allow-empty -m local
up="$(G "$tmp/up" rev-parse HEAD)" cl="$(P "$tmp/cl")"
nb="$(new --dir "$tmp/cl" --branch feat/x --agent "$tmp/bin/claude")" || fail "agents-new --branch failed"
[ "$(t display -p -t "$nb" '#{session_name}|#{pane_current_path}')" = "feat-x|$cl-worktrees/feat-x" ] || fail "new worktree session: $(t display -p -t "$nb" '#{session_name}|#{pane_current_path}')"
[ "$(G "$cl-worktrees/feat-x" rev-parse HEAD)" = "$up" ] || fail "new branch not made from origin's default branch"
G "$cl-worktrees/feat-x" rev-parse -q --verify '@{u}' >/dev/null && fail "new branch tracks main"
nb2="$(new --dir "$cl-worktrees/feat-x" --branch feat/x --agent "$tmp/bin/claude")"
[ "$(t display -p -t "$nb2" '#{pane_current_path}')" = "$cl-worktrees/feat-x" ] || fail "worktree not reused from inside it"
G "$tmp/cl" branch old
nb3="$(new --dir "$tmp/cl" --branch old --agent "$tmp/bin/claude")" || fail "agents-new on an existing branch"
[ "$(G "$cl-worktrees/old" branch --show-current)" = old ] || fail "existing branch not checked out in its worktree"
new --dir "$tmp/cl" --branch 'a..b' --agent "$tmp/bin/claude" 2>/dev/null && fail "agents-new took a bad branch name"
# The where step: the running agents' folders, a worktree as its main
# checkout, then each @agents_roots folder's subfolders.
mkdir -p "$tmp/roots/one" "$tmp/roots/two" "$tmp/roots/one-worktrees"
TMUX_PANE=$nb "$here/src/agent-state" running </dev/null
t set -g @agents_roots "$tmp/roots"
w="$(new --dirs)"
printf '%s\n' "$w" | grep -qx "$cl" || fail "where: no main checkout for a worktree agent: $w"
printf '%s\n' "$w" | grep -qx "$cl-worktrees/feat-x" && fail "where: listed the worktree, not its repo: $w"
for r in one two; do printf '%s\n' "$w" | grep -qx "$tmp/roots/$r" || fail "where: no $r from @agents_roots: $w"; done
[ "$(printf '%s\n' "$w" | sort | uniq -d)" = '' ] || fail "where: repeats: $w"
printf '%s\n' "$w" | grep -q 'one-worktrees' && fail "where: listed a worktrees folder: $w"
# A typed path lists the folders in it, as typed: no files, dotfolders only
# for a dot, the folder itself first when the path ends in /.
touch "$tmp/roots/file"; mkdir -p "$tmp/roots/.hid"
w="$(new --ls "$tmp/roots/" | cut -f2)"
[ "$w" = "$(printf '%s\n' "$tmp/roots/" "$tmp/roots/one-worktrees/" "$tmp/roots/one/" "$tmp/roots/two/")" ] || fail "where: ls of a path: $w"
w="$(new --ls "$tmp/roots/t")"
printf '%s\n' "$w" | grep -qx "$tmp/roots/two"$'\t'"$tmp/roots/two/" || fail "where: ls of a partial path: $w"
w="$(new --ls "$tmp/roots/." | cut -f2)"
printf '%s\n' "$w" | grep -qx "$tmp/roots/.hid/" || fail "where: no dotfolder after a dot: $w"
printf '%s\n' "$w" | grep -q '/\.\.*/$' && fail "where: listed . or .. after a dot: $w"
w="$(new --ls "$tmp/roots/x")"
printf '%s\n' "$w" | grep -q '\.hid' && fail "where: dotfolder without a dot: $w"
# shellcheck disable=SC2088   # the ~ is typed, not expanded
w="$(HOME="$tmp" new --ls '~/roots/o')"
printf '%s\n' "$w" | grep -qx "$tmp/roots/one"$'\t~/roots/one/' || fail "where: ~ not kept: $w"
t set -g @agents_roots "$tmp/roots"
[ "$(new --ls one)" = "$(new --dirs | while IFS= read -r x; do printf '%s\t%s\n' "$x" "${x/#$HOME/\~}"; done)" ] || fail "where: a word does not list the usual folders"
[ "$(new --tab x "$tmp/roots/one")" = "$tmp/roots/one/" ] || fail "where: tab did not descend"
[ "$(new --tab "$tmp/roots/" "$tmp/roots/")" = "$tmp/roots/" ] || fail "where: tab doubled the /"
[ "$(new --tab "$tmp/ro" '')" = "$tmp/ro" ] || fail "where: tab with nothing chosen changed the query"
t set -g @agents_roots ''
TMUX_PANE=$nb "$here/src/agent-state" clear </dev/null
for q in $np $np2 $np3 $nb $nb2 $nb3; do t kill-pane -t "$q"; done
t set -gu default-shell

# No agents left: the panel says so instead of going blank.
for p in $a $b $d; do TMUX_PANE=$p "$here/src/agent-state" clear </dev/null; done
"$here/src/agents" --list | grep -q 'no agents yet' || fail "empty state"
[ "$("$here/src/agents" --list | wc -l | tr -d ' ')" = 1 ] || fail "empty state is not one row"
NO_COLOR=1 "$here/src/agents" --list | grep -q $'\033' && fail "NO_COLOR left colour codes in the empty state"

# The prefix keys: @agents_key and @agents_key_dock, set before agents.tmux
# is sourced; empty binds nothing. Each on a fresh server, as a tmux.conf
# would be.
keys() { tmux -L "$sock-k" -f /dev/null new -d \; set -g @x 1 "$@" \; source-file "$here/agents.tmux" \; list-keys -T prefix; tmux -L "$sock-k" kill-server; }
kb="$(keys)"
grep -qE -- '-T prefix a +display-popup .*/src/agents$' <<<"$kb" || fail "a does not open the panel: $kb"
grep -qE -- "-T prefix A +run-shell .*/src/agents-dock toggle '?#\{window_id\}" <<<"$kb" || fail "A does not dock the panel: $kb"
kb="$(keys \; set -g @agents_key M-a \; set -g @agents_key_dock '')"
grep -qE -- '-T prefix M-a +display-popup .*/src/agents$' <<<"$kb" || fail "@agents_key not bound: $kb"
grep -q 'agents-dock' <<<"$kb" && fail "empty @agents_key_dock still bound: $kb"
grep -qE -- '-T prefix a +display-popup' <<<"$kb" && fail "a still bound with @agents_key set: $kb"
kb="$(keys \; set -g @agents_key 0)"   # a format's false, but a key
grep -qE -- '-T prefix 0 +display-popup .*/src/agents$' <<<"$kb" || fail "@agents_key 0 not bound: $kb"

# install.sh, in a throwaway home with no tmux server to reload: the tmux.conf
# block goes in once, and --remove takes out only that.
# Claude, Copilot and Pi look installed, and Claude already has a hook of the
# user's own that must survive both.
h="$tmp/home"; mkdir -p "$h/.claude" "$h/.copilot" "$h/.pi"; printf 'set -g mouse on\n' >"$h/.tmux.conf"
mine='{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"echo mine"}]}]}}'
printf '%s\n' "$mine" >"$h/.claude/settings.json"
inst() { out="$(env -u TMUX HOME="$h" TMUX_TMPDIR="$tmp" "$here/install.sh" "$@" 2>&1)" || fail "install.sh $*: $out"; }
ours() { jq '[.hooks[][].hooks[] | select(.command | test("agent-state"))] | length' "$h/.claude/settings.json"; }
inst; inst
[ "$(grep -c 'tmux-agent-corral >>>' "$h/.tmux.conf")" = 1 ] || fail "install.sh block not added exactly once"
[ -L "$h/.config/tmux/agents" ] || fail "install.sh did not link the clone"
[ "$(ours)" = 6 ] || fail "claude hooks: want 6 of ours after two installs, got $(ours)"
jq -e '.hooks.Stop[] | select(.hooks[0].command == "echo mine")' "$h/.claude/settings.json" >/dev/null || fail "install dropped the user's claude hook"
[ "$(readlink "$h/.copilot/hooks/agent-state.json")" = "$h/.config/tmux/agents/harnesses/copilot/hooks.json" ] || fail "install.sh did not link the copilot hooks"
[ "$(readlink "$h/.pi/agent/extensions/agent-state.ts")" = "$h/.config/tmux/agents/harnesses/pi/extension.ts" ] || fail "install.sh did not link the pi extension"
jq empty "$here/harnesses/copilot/hooks.json" || fail "harnesses/copilot/hooks.json is not valid JSON"
# doctor, on that install and this server: all good; then each break is named.
doc() { out="$(NO_COLOR=1 HOME="$h" "$here/src/doctor" 2>&1)"; }
doc || fail "doctor failed on a good install: $out"
case "$out" in *fail*|*warn*) fail "doctor complained about a good install: $out" ;; esac
ag="$(t new-window -d -P -F '#{pane_id}' -t side: "bash -c 'exec -a claude sleep 600'")"
doc; case "$out" in *"warn $ag "*"runs claude but reports nothing"*) ;; *) fail "doctor missed a silent agent: $out" ;; esac
TMUX_PANE=$ag "$here/src/agent-state" running </dev/null
doc; case "$out" in *"reports nothing"*) fail "doctor flagged a reporting agent: $out" ;; esac
t kill-pane -t "$ag"
t set -g @agents_notify /no/such/notifier
doc && fail "doctor passed a missing notifier"
case "$out" in *'fail @agents_notify runs /no/such/notifier'*) ;; *) fail "doctor on the notifier: $out" ;; esac
t set -g @agents_notify off
# Settings: a bare colour index (tmux styles refuse it), a colour the panel
# can't place, two panel actions on one key, a profile off PATH, and a prefix
# key set too late to be bound.
t set -g @agent_c_done 108
doc && fail "doctor passed a bare colour index"
case "$out" in *'fail @agent_c_done is 108; write colour108'*) ;; *) fail "doctor on a bare colour: $out" ;; esac
t set -g @agent_c_done darkorange
doc; case "$out" in *"warn @agent_c_done is darkorange, which the panel can't show"*) ;; *) fail "doctor on an X11 colour: $out" ;; esac
t set -g @agent_c_done colour108 \; set -g @agents_panel_key_group y
doc; case "$out" in *'warn panel keys: y is both approve and group'*) ;; *) fail "doctor on a shared panel key: $out" ;; esac
# fzf's lists split on , and its binds on :, so neither can be a key.
t set -g @agents_panel_key_group ,
[ "$("$here/src/agents" --keys | awk '$1 == "group" { print $2 }')" = g ] || fail "a , key replaced group's g"
doc; case "$out" in *"warn @agents_panel_key_group is ,, which the panel can't bind"*) ;; *) fail "doctor on a , key: $out" ;; esac
t set -gu @agents_panel_key_group \; set -g @agents_launch_zz /no/such/agent
doc; case "$out" in *"warn @agents_launch_zz runs /no/such/agent, which isn't on PATH"*) ;; *) fail "doctor on a profile off PATH: $out" ;; esac
t set -gu @agents_launch_zz \; set -g @agents_key M-z
doc; case "$out" in *"warn @agents_key is M-z, but prefix M-z doesn't open the panel"*) ;; *) fail "doctor on a late @agents_key: $out" ;; esac
t set -g @agents_key a
# A hook link that resolves, but not to this install's hook (a copy left from
# before the move to harnesses/).
ln -sfn "$here/README.md" "$h/.copilot/hooks/agent-state.json"
doc && fail "doctor passed a copilot link to elsewhere"
case "$out" in *"fail copilot: $h/.copilot/hooks/agent-state.json points at $here/README.md"*) ;; *) fail "doctor on a stray link: $out" ;; esac
rm "$h/.copilot/hooks/agent-state.json"
doc && fail "doctor passed missing copilot hooks"
case "$out" in *'fail copilot: no '*) ;; *) fail "doctor on copilot: $out" ;; esac
jq '.hooks.Stop |= map(select(any(.hooks[]; .command | test("agent-state")) | not))' "$h/.claude/settings.json" >"$tmp/s.json" && mv "$tmp/s.json" "$h/.claude/settings.json"
doc && fail "doctor passed a missing claude hook"
case "$out" in *'fail claude: no hook for Stop'*) ;; *) fail "doctor on claude's hooks: $out" ;; esac
inst
inst --remove
[ "$(cat "$h/.tmux.conf")" = 'set -g mouse on' ] || fail "install.sh --remove left: $(cat "$h/.tmux.conf")"
[ -e "$h/.config/tmux/agents" ] && fail "install.sh --remove left the link"
[ "$(jq -cS . "$h/.claude/settings.json")" = "$(jq -cS . <<<"$mine")" ] || fail "claude --remove left: $(jq -c . "$h/.claude/settings.json")"
[ -e "$h/.copilot/hooks/agent-state.json" ] && fail "install.sh --remove left the copilot hooks"
[ -e "$h/.pi/agent/extensions/agent-state.ts" ] && fail "install.sh --remove left the pi extension"
inst --no-tmux-conf
grep -q corral "$h/.tmux.conf" && fail "--no-tmux-conf edited tmux.conf"
# The piped-in install runs the clone at ~/.config/tmux/agents, and
# ~/.config/tmux may be a link into a dotfiles repo.
h="$tmp/home2"; mkdir -p "$h/.config" "$tmp/dotfiles/tmux/agents"; ln -s "$tmp/dotfiles/tmux" "$h/.config/tmux"
(cd "$here" && git ls-files -z | xargs -0 tar cf -) | tar xf - -C "$tmp/dotfiles/tmux/agents"
out="$(env -u TMUX HOME="$h" TMUX_TMPDIR="$tmp" "$h/.config/tmux/agents/install.sh" --no-tmux-conf 2>&1)" ||
  fail "install.sh from a clone under a linked ~/.config/tmux: $out"

# The release's changelog entry: a merge body is the PR title, footers count,
# repeats collapse, and docs-only history gives no sections.
notes="$("$here/scripts/changelog-notes" <<'MSGS'
Merge pull request #10 from x/pr

feat: panel shows cost
wip
refactor: rename y

BREAKING CHANGE: y is now z
feat(panel)!: drop the old keys
perf: faster scan
fix(install): handle links
fix(install): handle links
docs: d
MSGS
)"
want='### Added

- panel shows cost

### Changed

- **Breaking:** y is now z
- **Breaking:** drop the old keys
- faster scan

### Fixed

- handle links'
[ "$notes" = "$want" ] || fail "changelog-notes gave:
$notes"
[ -z "$("$here/scripts/changelog-notes" <<<'docs: d')" ] || fail "changelog-notes listed a docs commit"

echo ok
