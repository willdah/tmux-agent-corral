#!/usr/bin/env bash
# harnesses/claude/install [--remove|--check] [settings.json]
#
# Wires Claude Code's lifecycle hooks to agent-state so every Claude session
# shows up in the tmux status line, window tabs and agents panel. Merges into
# the existing settings (default ~/.claude/settings.json): only entries that
# call agent-state are touched, everything else is left as it is. Idempotent:
# a re-run replaces our entries rather than adding duplicates.
#
#   --remove   take our hooks out again
#   --check    only look: an "ok <what>" or "fail <what>" line per finding on
#              stdout, for the doctor; exits 1 on a fail
set -euo pipefail

# shellcheck source=src/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../../src" && pwd)/common.sh"

# The hooks we install: event, matcher (- for every one), state.
EVENTS='SessionStart     startup|resume|clear                 idle
UserPromptSubmit -                                    running
PostToolUse      -                                    running
Notification     permission_prompt|elicitation_dialog input
Stop             -                                    done
SessionEnd       -                                    clear'

remove=0 check=0
case "${1:-}" in --remove) remove=1; shift ;; --check) check=1; shift ;; esac
f="${1:-$HOME/.claude/settings.json}"
cmd="$AGENTS_HOME/src/agent-state"

if [ $check = 1 ]; then
  bad=0
  if ! have="$(jq -r '.hooks // {} | to_entries[]
        | select(any(.value[]?.hooks[]?; (.command // "") | test("agent-state"))) | .key' "$f" 2>/dev/null)"; then
    echo "fail can't read $f; run install.sh"; exit 1
  fi
  missing=''
  for e in $(cut -d" " -f1 <<<"$EVENTS"); do
    grep -qx "$e" <<<"$have" || missing+=" $e"
  done
  if [ -z "$have" ]; then echo "fail no hooks in $f; run install.sh"; bad=1
  elif [ -n "$missing" ]; then echo "fail no hook for$missing in $f; run install.sh"; bad=1
  elif [ "$(jq '.disableAllHooks // false' "$f")" = true ]; then echo "fail disableAllHooks is on in $f"; bad=1
  else echo "ok hooks in $f"; fi
  # The command is `"<path>" <state>`: the path has to be there.
  while read -r p; do
    [ -x "$p" ] || { echo "fail the hooks call $p, which isn't there; run install.sh"; bad=1; }
  done < <(jq -r '.hooks // {} | .[][].hooks[]?.command // empty | select(test("agent-state"))' "$f" |
             sed -n 's/^"\([^"]*\)".*/\1/p' | sort -u)
  exit "$bad"
fi
[ $remove = 0 ] || [ -f "$f" ] || exit 0

command -v jq >/dev/null 2>&1 || die "jq not found (brew install jq)"
mkdir -p "$(dirname "$f")"
[ -s "$f" ] || printf '{}\n' >"$f"

tmp="$(mktemp "$f.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

jq --arg cmd "$cmd" --arg events "$EVENTS" --argjson remove "$remove" '
  # Ours = any hook whose command runs agent-state, wherever it was installed.
  def ours: (.command // "") | test("agent-state");
  # Drops only the groups and events that held nothing but our hooks; anything
  # that was already empty stays as it was.
  def strip:
    .hooks //= {}
    | .hooks |= with_entries(
        .value as $was
        | .value |= map(
            if any(.hooks[]?; ours)
            then (.hooks |= map(select(ours | not))) | select(.hooks | length > 0)
            else . end)
        | select((.value | length > 0) or ($was | length == 0)));
  def add(event; matcher; state):
    .hooks[event] += [
      (if matcher then {matcher: matcher} else {} end)
      + {hooks: [{type: "command", command: "\"\($cmd)\" \(state)", timeout: 5}]}
    ];

  strip
  | if $remove == 1 then . else
      reduce ($events | split("\n")[] | [splits(" +")]) as [$e, $m, $s]
        (.; add($e; if $m == "-" then null else $m end; $s))
    end
' "$f" >"$tmp" || die "could not update $f (is it valid JSON?)"

if cmp -s "$tmp" "$f"; then
  ok "claude agent hooks already $([ $remove = 1 ] && echo removed || echo installed) in $f"
  exit 0
fi

cp "$f" "$f.bak"
mv "$tmp" "$f"
ok "claude agent hooks $([ $remove = 1 ] && echo removed from || echo installed in) $f (previous copy: $f.bak)"
