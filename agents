#!/usr/bin/env bash
# agents [--watch]
#
# One panel for every agent session in every tmux session, window and pane.
# Reads the pane options that `agent-state` sets; see that script for the
# protocol. Rows that need you sort first (waiting on you, then finished,
# then idle; working last), oldest wait at the top. A row shows the session's
# name (one you gave it with n, else the pane title Claude Code sets, else the
# tmux session) and its project (the git repo it runs in, else the directory).
#
#   agents            popup panel: Enter jumps to the agent and closes
#   agents --watch    pinned panel: stays open, Enter shows the agent and keeps focus, p toggles preview
#   agents --list     the column headings, then the rows, tab-separated (pane id, display)
#
# Keys: ↵ jump · y approve · m message · n rename · x interrupt · r refresh · q close
#
# Columns fit the panel's width (fzf's $FZF_COLUMNS), headings included.
# NO_COLOR turns the colours off.
set -euo pipefail

self="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

die() { printf '\033[1;31mfail\033[0m %s\n' "$*" >&2; exit 1; }

# Palette: the state colours come from ~/.tmux.conf (@agent_c_*), so the panel
# and the status line can't drift apart. Both greys clear 4.5:1 on a dark
# terminal, the selected row included; a light theme sets @agent_c_text/dim.
read -r AMBER BLUE GREEN TEXT DIM <<<"$(tmux display -p '#{@agent_c_input} #{@agent_c_running} #{@agent_c_done} #{@agent_c_text} #{@agent_c_dim}' 2>/dev/null || true)"
AMBER="${AMBER:-214}" BLUE="${BLUE:-110}" GREEN="${GREEN:-108}" TEXT="${TEXT:-250}" DIM="${DIM:-247}"
B=$'\033[1m' UB=$'\033[22m'   # bold carries the footer's keys; NO_COLOR keeps it
if [ -n "${NO_COLOR:-}" ]; then
  AMBER='' BLUE='' GREEN='' TEXT='' DIM='' R=''
else
  for v in AMBER BLUE GREEN TEXT DIM; do printf -v "$v" '\033[38;5;%sm' "${!v}"; done
  R=$'\033[0m'
fi

# The helpers below write into the variable named by their first argument
# (printf -v) instead of printing: --list runs on every refresh, and a $( )
# per cell was most of its time.

# age <var> <epoch>, counted from $now.
age() {
  local s=$(( now - ${2:-0} ))
  if   [ "$s" -lt 60 ];    then printf -v "$1" '%ss' "$s"
  elif [ "$s" -lt 3600 ];  then printf -v "$1" '%sm' $(( s / 60 ))
  elif [ "$s" -lt 86400 ]; then printf -v "$1" '%sh' $(( s / 3600 ))
  else                          printf -v "$1" '%sd' $(( s / 86400 ))
  fi
}

# fit <var> <width> <text>: truncate with … and pad to width, counting
# characters, not bytes, so titles with › or emoji keep the columns aligned.
fit() {
  local n="$2" s="$3"
  [ "${#s}" -gt "$n" ] && s="${s:0:n-1}…"
  printf -v "$1" '%s%*s' "$s" $(( n - ${#s} )) ''
}

# project <var> <dir>: the repo a path belongs to, named by its main checkout
# so every worktree of a repo shows the same project. Outside a repo, or when
# git fails, it names the directory and returns 1.
project() {
  local g rc=0
  g="$(git -C "$2" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || { g="$2"; rc=1; }
  case "$g" in (*/.git) g="${g%/.git}" ;; esac
  g="${g##*/}"
  printf -v "$1" '%s' "${g:-/}"
  return "$rc"
}

# The agent is gone when its pane is back at a bare shell with nothing running
# under it (a crash or kill -9 skips SessionEnd). A bash wrapper like ai-loop
# also shows as `bash`, but it has children, so it stays.
stale() {
  case "$1" in zsh|-zsh|bash|-bash|fish|sh|dash) ;; *) return 1 ;; esac
  ! pgrep -P "$2" >/dev/null 2>&1
}

list() {
  local US=$'\037'   # unit separator: unlike a tab, read keeps empty fields
  local fmt="#{pane_id}${US}#{@agent_state}${US}#{@agent_since}${US}#{@agent}${US}#{session_name}${US}#{pane_current_path}${US}#{pane_current_command}${US}#{pane_pid}${US}#{@agent_dir}${US}#{@agent_project}${US}#{@agent_name}${US}#{pane_title}"
  local rows host="${HOSTNAME:-$(hostname)}" now
  now="$(date +%s)"
  # tmux before 3.5 prints the separator as a literal \037; turn it back.
  rows="$(tmux list-panes -a -f '#{@agent_state}' -F "$fmt" | sed "s/\\\\037/$US/g" | while IFS="$US" read -r id st since agent sess dir cmd pid pdir proj name title; do
    if stale "$cmd" "$pid"; then
      tmux set -pu -t "$id" @agent_state \; set -pu -t "$id" @agent_dir \; set -pu -t "$id" @agent_project 2>/dev/null || true
      continue
    fi
    # git runs once per pane and directory; the project then stays on the
    # pane until agent-state clears it with the rest. Only a git answer is
    # kept, so a failure (safe.directory, a repo made later) does not stick.
    # ponytail: outside a repo git runs on every refresh; cache that too if
    # agents there ever get common.
    if [ "$pdir" != "$dir" ] && project proj "$dir"; then
      tmux set -p -t "$id" @agent_dir "$dir" \; set -p -t "$id" @agent_project "$proj" 2>/dev/null || true
    fi
    case "$st" in   # (pattern) form: bash 3.2 misparses `pattern)` inside $( )
      (input)   rank=0 ;;
      (done)    rank=1 ;;
      (running) rank=3 ;;
      (*)       rank=2 ;;
    esac
    # Claude prefixes its title with a status glyph (✳, or a spinner); tmux
    # falls back to the hostname when nothing set one. Copilot and Pi only
    # name themselves (Pi with its directory), which says nothing new.
    case "$title" in ("π - ${dir##*/}") title= ;; esac
    case "${title%% *}" in (*[[:alnum:]]*) ;; (*) title="${title#* }" ;; esac
    case "$title" in ("$host"|'Claude Code'|'GitHub Copilot') title= ;; esac
    printf "%s${US}%s${US}%s${US}%s${US}%s${US}%s${US}%s\n" "$rank" "${since:-0}" "$id" "$st" "$agent" "$proj" "${name:-${title:-$sess}}"
  done | sort -t"$US" -k1,1n -k2,2n)"

  # Width: fzf's columns inside its border, less 4 for padding, pointer and
  # gutter and one spare for the scrollbar. fzf reports 0 during its start
  # event, so the first list measures fzf's terminal itself (its width less
  # the border's 4): not the tmux pane, which under a popup is the pane
  # beneath it. Status, age and gaps are fixed; the title gets what's left
  # after the project's third (up to 14 columns).
  local cols="${FZF_COLUMNS:-0}" w=''
  if [ "$cols" -le 0 ]; then
    w="$( (stty size </dev/tty) 2>/dev/null || true)"
    cols=$(( ${w#* } - 4 ))
    [ "$cols" -gt 0 ] || cols=80
  fi
  cols=$(( cols - 5 ))

  # widths <who>: sets tw and pw (0: no project column) for a row whose
  # harness label is <who>. Too narrow for both, the project goes so the age,
  # which the sort runs on, never gets cut off.
  widths() {
    local rest=$(( cols - 20 - ${#1} ))
    if [ "$rest" -ge 24 ]; then
      pw=$(( rest / 3 )); [ "$pw" -gt 14 ] && pw=14
      tw=$(( rest - pw ))
    else
      pw=0 tw=$(( rest + 1 )); [ "$tw" -lt 6 ] && tw=6
    fi
  }

  # The headings: fzf pins the first line (--header-lines), so it's printed
  # even with no rows. They line up with Claude's rows.
  local tw pw cell where=''
  widths ''
  [ "$pw" -gt 0 ] && { fit cell "$pw" PROJECT; where=" $cell"; }
  fit cell "$tw" SESSION
  printf -- '-\t%s %-11s  %s%s %4s%s\n' "$DIM" STATE "$cell" "$where" AGE "$R"

  if [ -z "$rows" ]; then
    printf -- '-\t%s  no agents yet. Start claude, copilot or pi in any pane.%s\n' "$DIM" "$R"
    return
  fi

  while IFS="$US" read -r _ since id st agent proj title; do
    local glyph label col who='' ago
    where=''
    case "$st" in
      input)   glyph='▲' label='needs you' col=$AMBER ;;
      running) glyph='●' label='working'   col=$BLUE  ;;
      done)    glyph='✓' label='finished'  col=$GREEN ;;
      *)       glyph='○' label='idle'      col=$DIM   ;;
    esac
    # Claude is the default harness; only another one is worth the columns.
    [ "$agent" = claude ] || who="  $agent"
    widths "$who"
    [ "$pw" -gt 0 ] && { fit cell "$pw" "$proj"; where=" $DIM$cell$R"; }
    fit cell "$tw" "$title"; age ago "$since"
    printf '%s\t %s%s %-9s%s  %s%s%s%s %s%4s%s%s%s%s\n' \
      "$id" \
      "$col" "$glyph" "$label" "$R" \
      "$TEXT" "$cell" "$R" \
      "$where" \
      "$DIM" "$ago" "$R" \
      "$DIM" "$who" "$R"
  done <<<"$rows"
}

# A row id is a pane id; the empty-state row uses "-". (fzf 0.74 hangs on
# --track after a reload when the tracked row's id field is empty.)
is_pane() { case "${1:-}" in %*) return 0 ;; esac; return 1; }

# With "stay" (the docked panel), the panel moves to the agent's window before
# the switch, so the switch hooks find it already there, then takes focus back:
# the agent is that window's last pane. Where the panel can't follow (a zoomed
# or narrow window) the agent keeps focus. Either way the focus hook may not
# fire on the agent, so mark a finished one seen here.
jump() {
  is_pane "${1:-}" || return 0
  if [ "${2:-}" = stay ]; then
    "${self%/*}/agents-dock" follow "$(tmux display -p -t "$1" '#{window_id}')" ||
      tmux display-message "agents: the panel could not follow"
  fi
  tmux switch-client -t "$1" \; select-window -t "$1" \; select-pane -t "$1"
  [ "${2:-}" = stay ] || return 0
  local dock
  dock="$(tmux show -gv @agents_dock 2>/dev/null)" && tmux select-pane -t "$dock"
  if [ "$(tmux display -p -t "$1" '#{@agent_state}')" = done ]; then
    tmux set -p -t "$1" @agent_state idle \; wait-for -S agents
  fi
}

# Only an agent that is actually waiting gets keystrokes; anywhere else an
# Enter or Escape lands in whatever happens to be on screen.
waiting() { [ "$(tmux display -p -t "$1" '#{@agent_state}' 2>/dev/null)" = input ]; }

approve() {
  is_pane "${1:-}" && waiting "$1" || { tmux display-message "agents: that one isn't waiting for you"; return 0; }
  tmux send-keys -t "$1" Enter
}

# Escape (C-c for Copilot) stops a working agent; on a prompt it would dismiss
# the question, so only a working agent gets it.
interrupt() {
  is_pane "${1:-}" || return 0
  [ "$(tmux display -p -t "$1" '#{@agent_state}' 2>/dev/null)" = running ] ||
    { tmux display-message "agents: that one isn't working"; return 0; }
  if [ "$(tmux display -p -t "$1" '#{@agent}' 2>/dev/null)" = copilot ]; then
    # Copilot ignores a sent Escape, and its cancel fires no hook. Mark it
    # idle here, or a second x would send the C-c that quits it.
    tmux send-keys -t "$1" C-c
    TMUX_PANE="$1" "${self%/*}/agent-state" idle copilot </dev/null
  else
    tmux send-keys -t "$1" Escape
  fi
}

message() {
  is_pane "${1:-}" || return 0
  local msg
  printf '\n  %s›%s message for %s: ' "$BLUE" "$R" "$(tmux display -p -t "$1" '#{session_name} › #{b:pane_current_path}')"
  IFS= read -re msg || return 0
  [ -n "$msg" ] || return 0
  tmux send-keys -t "$1" -l -- "$msg"
  tmux send-keys -t "$1" Enter
}

# The name shows in place of the agent's own title until the pane closes or
# the agent ends; an empty name hands the row back to that title.
rename() {
  is_pane "${1:-}" || return 0
  local name
  printf '\n  %s›%s name for %s (empty resets): ' "$BLUE" "$R" "$(tmux display -p -t "$1" '#{session_name} › #{b:pane_current_path}')"
  IFS= read -re name || return 0
  if [ -n "$name" ]; then tmux set -p -t "$1" @agent_name "$name"
  else tmux set -pu -t "$1" @agent_name 2>/dev/null || true
  fi
}

panel() {
  command -v fzf >/dev/null 2>&1 || die "fzf not found (brew install fzf)"
  local watch="${1:-}" enter preview keys
  # The docked panel is narrow, so its key hints are shorter.
  if [ "$watch" = watch ]; then
    enter="execute-silent($self --jump {1} stay)"
    preview='down,60%,follow,border-top,hidden'
    keys='↵ jump|y approve|m msg|n name|x stop|p peek|q close'
  else
    enter="become($self --jump {1})"
    preview='down,65%,follow,border-top'
    keys='↵ jump|y approve|m message|n rename|x interrupt|p preview|q close'
  fi
  local footer='' k
  while IFS= read -r -d '|' k; do
    footer+="$B$TEXT${k%% *}$UB$DIM ${k#* }  "
  done <<<"$keys|"

  # Refresh through fzf's own HTTP port: at once when agent-state signals the
  # agents channel, and every 10s for the ages and for agents that died
  # without a word. Each loop ends on its first reload after fzf has gone.
  local reload="curl -fs -XPOST localhost:\$FZF_PORT -d 'reload-sync($self --list)'"
  local tick="(while sleep 10 && $reload; do :; done) >/dev/null 2>&1 & (while tmux wait-for agents && $reload; do :; done) >/dev/null 2>&1 &"

  local label='[ {1} != - ] && tmux display -p -t {1} " #{session_name}:#{window_index}.#{pane_index}  #{pane_current_path} "'

  # The first list loads through reload so it, too, sees $FZF_COLUMNS.
  fzf </dev/null \
    --ansi --no-input --no-sort --layout=reverse --cycle \
    --delimiter=$'\t' --with-nth=2 --id-nth=1 --track --header-lines=1 \
    --listen --bind "start:reload-sync($self --list)+execute-silent:$tick" \
    --bind "resize:reload-sync($self --list)" \
    --border=rounded --border-label=' agent-corral ' --border-label-pos=3 \
    --info=hidden --pointer='▌' --gutter=' ' \
    --footer="${footer%  }" \
    --footer-border=line \
    --preview='[ {1} != - ] && tmux capture-pane -pe -J -t {1} -S -80 | awk "{l[NR]=\$0} NF{n=NR} END{for(i=1;i<=n;i++)print l[i]}"' \
    --preview-window="$preview" \
    --bind="focus:transform-preview-label:$label" \
    --color='fg:250,bg:-1,fg+:255,bg+:236,hl:110,hl+:110' \
    --color='border:238,label:110,preview-border:238,preview-label:247,footer-border:238' \
    --color='pointer:110,marker:110,gutter:-1,info:247,header:250' \
    --bind="enter:$enter" \
    --bind="y:execute-silent($self --approve {1})+reload-sync($self --list)" \
    --bind="x:execute-silent($self --interrupt {1})" \
    --bind="m:execute($self --message {1})+reload-sync($self --list)" \
    --bind="n:execute($self --rename {1})+reload-sync($self --list)" \
    --bind="r:reload-sync($self --list)" \
    --bind="p:toggle-preview+transform-preview-label:$label" \
    --bind='j:down,k:up,q:abort,esc:abort' \
    >/dev/null || true
  # Wake this panel's waiter so it sees fzf gone and exits now, not on the
  # next state change; any other open panel just reloads once.
  tmux wait-for -S agents 2>/dev/null || true
}

case "${1:-}" in
  '')          panel ;;
  --watch)     panel watch ;;
  --list)      list ;;
  --jump)      jump "${2:-}" "${3:-}" ;;
  --approve)   approve "${2:-}" ;;
  --interrupt) interrupt "${2:-}" ;;
  --message)   message "${2:-}" ;;
  --rename)    rename "${2:-}" ;;
  *)           die "usage: $(basename "$0") [--watch|--list]" ;;
esac
