#!/usr/bin/env bash
# agents [--watch]
#
# One panel for every agent session in every tmux session, window and pane.
# Reads the pane options that `agent-state` sets; see that script for the
# protocol. Rows that need you sort first (waiting on you, then finished,
# then idle; working last), oldest wait at the top. A row shows the session's
# name (one you gave it with n, else the pane title Claude Code sets, else the
# tmux session, or the directory when grouped) and its project (the git repo
# it runs in, else the directory).
#
#   agents            popup panel: Enter jumps to the agent and closes
#   agents --watch    pinned panel: stays open, Enter shows the agent and keeps focus, p toggles preview
#   agents --list     the rows, tab-separated (pane id, display, full name)
#   agents --list0    the same, NUL-separated, for the panel (fzf --read0)
#   agents --rows     the data behind the rows, for scripts: one tab-separated
#                     record per agent in panel order, no headings or colours:
#                     rank (0 needs you, 1 finished, 2 idle, 3 working), since
#                     (epoch), pane id, state, harness, project, name, session.
#                     Grouped, a heading record leads each session: rank H,
#                     its counts by rank in the state field, -<session> as id.
#
# Keys: ↵ jump · y approve · m message · n rename · x interrupt · d kill · c new · g group · r refresh · q close
# (@agents_panel_key_<action> moves one; agents --keys lists them as set:
# action, key, popup hint, dock hint).
#
# With @agents_group on (g toggles it), the rows sit under a heading per tmux
# session, each in the usual order. The session holding the most urgent row
# comes first (ties by name), so what needs you still tops the panel. A
# heading names the session and counts its agents by state. Its id is
# -<session>: unique for --track, and no pane, so actions skip it, all but n,
# which renames the session.
#
# The panel is three boxes: a summary of the agents by state, the filter
# (shown only while you use it: / opens it, // or esc closes it) and the list.
# It animates on fzf's every() timer: needs you breathes while anyone waits,
# and a working agent's row carries a travelling wave and a shine. Each frame
# re-shows fzf's cursor, so nothing animates while the filter or a field is
# open.
#
# Columns fit the panel's width (fzf's $FZF_COLUMNS).
# NO_COLOR turns the colours off.
set -euo pipefail

self="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# shellcheck source=src/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
shopt -s extglob

# The panel keeps its state in $AGENTS_STATE: the rows it last read (rows),
# their counts (sum: a generation, then the agents needing you, working, done
# and idle, and when the oldest wait began) and the frame number. An animation
# frame redraws from those without asking tmux again. --tick runs five times a
# second (faster starves fzf of the keys you press), so it answers here,
# before the palette below costs it a tmux call.
tick() {
  local s="$AGENTS_STATE" frame=0 gen nin nrun seen='' act=''
  read -r frame 2>/dev/null <"$s/frame" || true
  echo $(( frame + 1 )) >"$s/frame"
  read -r gen nin nrun _ 2>/dev/null <"$s/sum" || gen=0 nin=0 nrun=0
  read -r seen 2>/dev/null <"$s/seen" || true
  # The reload last: fzf drops what follows a reload-sync in one transform.
  if [ -f "$s/label" ] || [ -f "$s/shimmer" ]; then rm -f "$s/label"; act+="+transform-header-label($self --label)"; fi
  if [ "${FZF_INPUT_STATE:-}" = hidden ] && [ $(( nin + nrun )) -gt 0 ]; then seen=animating; fi
  if [ "$gen" != "$seen" ]; then echo "$gen" >"$s/seen"; act+="+bg-transform-header($self --header)"; fi
  # The rows hold still for a second after each key: a reload under a key
  # press loses it or moves the cursor.
  if [ "${FZF_INPUT_STATE:-}" = hidden ] && [ "$nrun" -gt 0 ] && [ "${FZF_IDLE_TIME_MS:-1000}" -ge 1000 ]; then
    act+="+reload-sync($self --frame)"
  fi
  printf '%s' "${act#+}"
}
[ "${1:-}" = --tick ] && { tick; exit 0; }

# Palette (see common.sh): both greys clear 4.5:1 on a dark terminal, the
# selected row included; a light theme sets @agent_c_text/dim. FAINT, the
# group rule, is structure, not text, so the border's grey.
palette
B=$'\033[1m' UB=$'\033[22m'   # bold carries the footer's keys; NO_COLOR keeps it
# A shine's centre and its falloff, over working blue.
LIT=$'\033[38;5;255m' GLOW=$'\033[38;5;189m' HALO=$'\033[38;5;153m'
# The title's gold, and the light gold of the shine that sweeps it.
GOLD=$'\033[38;2;232;196;104m' GOLD1=$'\033[38;2;255;246;214m' GOLD2=$'\033[38;2;246;222;150m'
[ -z "${NO_COLOR:-}" ] || LIT='' GLOW='' HALO='' GOLD='' GOLD1='' GOLD2=''

# The frame the panel is on; --list, outside it, has none and draws still.
frame=0
[ -z "${AGENTS_STATE:-}" ] || read -r frame 2>/dev/null <"$AGENTS_STATE/frame" || true

# A working agent's mark: a braille sine wave two cells wide that travels a
# dot column a frame.
WAVE=(⠊⠑ ⠔⠉ ⡠⠊ ⣀⠔ ⢄⡠ ⠢⣀ ⠑⢄ ⠉⠢)

# pulse: sets PULSE, the needs-you colour breathing from 45% to full and back
# every 1.6s (8 frames), in true colour. One of the 16 basic colours has no fixed value
# to scale, so it swaps faint for bold.
# shellcheck disable=SC2154   # palette sets ac
pulse() {
  local k=$(( frame % 8 )) i=$ac r g b f v=(0 95 135 175 215 255)
  [ "$k" -le 4 ] || k=$(( 8 - k ))
  if [ -z "$AMBER" ]; then PULSE=''; return; fi
  case "$i" in
    ('#'*) r=$(( 0x${i:1:2} )) g=$(( 0x${i:3:2} )) b=$(( 0x${i:5:2} )) ;;
    (*) if [ "$i" -ge 232 ]; then r=$(( 8 + 10 * (i - 232) )) g=$r b=$r
        elif [ "$i" -ge 16 ]; then i=$(( i - 16 )); r=${v[i / 36]} g=${v[i / 6 % 6]} b=${v[i % 6]}
        elif [ "$k" -lt 2 ]; then PULSE=$'\033[2m'"$AMBER"; return
        else PULSE=$'\033[1m'"$AMBER"; return; fi ;;
  esac
  f=$(( 45 + 55 * k / 4 ))
  printf -v PULSE '\033[38;2;%d;%d;%dm' $(( r * f / 100 )) $(( g * f / 100 )) $(( b * f / 100 ))
}

# band <distance>: sets c, the colour a shine gives a cell that far from its
# centre: lit, glowing, a halo, then the base colour in $base.
band() {
  case "${1#-}" in (0) c=$LIT ;; (1) c=$GLOW ;; (2) c=$HALO ;; (*) c=$base ;; esac
}

# shine <var> <text> <pos>: text in the row's colour with a bright band
# centred on pos, for a working agent's name.
shine() {
  local t="$2" i c last='' out='' base=$TEXT
  for (( i = 0; i < ${#t}; i++ )); do
    band $(( i - $3 )); [ "$c" = "$last" ] || { out+=$c; last=$c; }
    out+="${t:i:1}"
  done
  printf -v "$1" '%s%s' "$out" "$R"
}

# The helpers below write into the variable named by their first argument
# (printf -v) instead of printing: --list runs on every refresh, and a $( )
# per cell was most of its time.

# age <var> <epoch>, counted from $now.
age() {
  local s=$(( now - ${2:-0} ))
  if   [ "$s" -lt 60 ];    then printf -v "$1" '%ss' "$s"
  elif [ "$s" -lt 3600 ];  then printf -v "$1" '%sm' $(( s / 60 ))
  elif [ "$s" -lt 86400 ]; then printf -v "$1" '%sh' $(( s / 3600 ))
  else                          printf -v "$1" '%sd' $(( s / 86400 ))
  fi
}

# widths: from $cols, sets tw, pw (0: no project column), aw (0: no agent
# column) and rw, the width of a row, the same for every row so the columns line up. The title stops at
# 36 so a wide popup doesn't open a gulf before the project. The agent column
# comes only with room to spare (not in the dock), then the project goes when
# too narrow for it, so state, title and age, which the sort runs on, always
# show.
widths() {
  local fixed=9   # state mark, gaps and age: everything but title, project and agent
  local rest=$(( cols - fixed - 1 ))   # less the space before the project
  aw=7   # copilot, the longest built-in harness; a longer name gets cut
  if [ $(( rest - aw - 1 )) -ge 40 ]; then rest=$(( rest - aw - 1 )); else aw=0; fi
  if [ "$rest" -ge 24 ]; then
    pw=$(( rest / 3 )); [ "$pw" -gt 22 ] && pw=22
    tw=$(( rest - pw )); [ "$tw" -le 36 ] || tw=36
  else
    pw=0 tw=$(( rest + 1 )); [ "$tw" -ge 6 ] || tw=6
  fi
  rw=$(( fixed + tw + (pw > 0 ? pw + 1 : 0) + (aw > 0 ? aw + 1 : 0) ))
}

# fit <var> <width> <text>: truncate with … and pad to width, counting
# characters, not bytes, so titles with › or emoji keep the columns aligned.
fit() {
  local n="$2" s="$3"
  [ "${#s}" -gt "$n" ] && s="${s:0:n-1}…"
  printf -v "$1" '%s%*s' "$s" $(( n - ${#s} )) ''
}

# project <var> <dir>: the repo a path belongs to, named by its main checkout
# so every worktree of a repo shows the same project. Outside a repo, or when
# git fails, it names the directory and returns 1.
project() {
  local g rc=0
  g="$(git -C "$2" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || { g="$2"; rc=1; }
  case "$g" in (*/.git) g="${g%/.git}" ;; esac
  g="${g##*/}"
  printf -v "$1" '%s' "${g:-/}"
  return "$rc"
}

US=$'\037'   # unit separator: unlike a tab, read keeps empty fields

# rows: the records behind the panel, sorted and, with @agents_group on,
# grouped; see --rows for the fields. Its one write is the project cache
# below. It clears nothing: agents that died without a word stay listed until
# `agent-state sweep`, which the panel runs on open and every 10s.
rows() {
  local fmt="#{pane_id}${US}#{@agent_state}${US}#{@agent_since}${US}#{@agent}${US}#{session_name}${US}#{pane_current_path}${US}#{@agent_dir}${US}#{@agent_project}${US}#{@agent_name}${US}#{pane_title}"
  local host="${HOSTNAME:-$(hostname)}" group fb keys=('-k1,1n' '-k2,2n')
  group="$(tmux show -gv @agents_group 2>/dev/null || true)"
  [ "$group" = on ] && keys+=('-k8,8')
  # Grouped, awk gathers each session's rows in the order its first (most
  # urgent) row came, behind a heading record: H, then the counts by rank.
  # tmux before 3.5 prints the separator as a literal \037; turn it back.
  tmux list-panes -a -f '#{@agent_state}' -F "$fmt" | sed "s/\\\\037/$US/g" | while IFS="$US" read -r id st since agent sess dir pdir proj name title; do
    # git runs once per pane and directory; the project then stays on the
    # pane until agent-state clears it with the rest. Only a git answer is
    # kept, so a failure (safe.directory, a repo made later) does not stick.
    # ponytail: outside a repo git runs on every refresh; cache that too if
    # agents there ever get common.
    if [ "$pdir" != "$dir" ] && project proj "$dir"; then
      tmux set -p -t "$id" @agent_dir "$dir" \; set -p -t "$id" @agent_project "$proj" 2>/dev/null || true
    fi
    case "$st" in   # (pattern) form: bash 3.2 misparses `pattern)` inside $( )
      (input)   rank=0 ;;
      (done)    rank=1 ;;
      (running) rank=3 ;;
      (*)       rank=2 ;;
    esac
    # Claude prefixes its title with a status glyph (✳, or a spinner); tmux
    # falls back to the hostname when nothing set one. Copilot and Pi only
    # name themselves (Pi with its directory), which says nothing new.
    case "$title" in ("π - ${dir##*/}") title= ;; esac
    case "${title%% *}" in (*[[:alnum:]]*) ;; (*) title="${title#* }" ;; esac
    case "$title" in ("$host"|'Claude Code'|'GitHub Copilot') title= ;; esac
    # Under the session heading, an untitled row names its directory instead.
    fb="$sess"; [ "$group" = on ] && fb="${dir##*/}"
    printf "%s${US}%s${US}%s${US}%s${US}%s${US}%s${US}%s${US}%s\n" "$rank" "${since:-0}" "$id" "$st" "$agent" "$proj" "${name:-${title:-$fb}}" "$sess"
  done | sort -t"$US" "${keys[@]}" | if [ "$group" = on ]; then
    awk -F"$US" -v OFS="$US" '
      !($8 in r) { o[k++] = $8 }
      { c[$8, $1]++; r[$8] = r[$8] $0 "\n" }
      END { for (i = 0; i < k; i++) { s = o[i]
        print "H", "", "-" s, (c[s,0]+0) " " (c[s,1]+0) " " (c[s,2]+0) " " (c[s,3]+0), "", "", "", s
        printf "%s", r[s] } }'
  else cat; fi
}

# panel_cols: sets cols, the width a row or the summary may take: fzf's
# columns less the boxes' borders and padding, the pointer and gutter and a
# spare for the scrollbar. fzf reports 0 during its start event, so the first
# list measures fzf's terminal itself: not the tmux pane, which under a popup
# is the pane beneath it. In the popup the peek takes the right 55%.
panel_cols() {
  local w=''
  cols="${FZF_COLUMNS:-0}"
  if [ "$cols" -le 0 ]; then
    w="$( (stty size </dev/tty) 2>/dev/null || true)"
    cols=$(( ${w#* } + 0 ))
    [ "$cols" -gt 0 ] || cols=80
  fi
  [ -z "${AGENTS_SIDE:-}" ] || cols=$(( cols * 45 / 100 ))
  cols=$(( cols - 7 ))
}

# keep <rows>: the panel's copy of the rows, and their counts, for --tick,
# --frame and --header. Each lands whole (mv), as a frame may be reading.
keep() {
  local s="$AGENTS_STATE" gen=0
  read -r gen _ 2>/dev/null <"$s/sum" || true
  printf '%s\n' "$1" >"$s/rows.$$" && mv "$s/rows.$$" "$s/rows"
  printf '%s\n' "$1" | awk -F"$US" -v g=$(( gen + 1 )) '
    $1 == "H" || $3 == "" { next }
    { c[$4]++; t++ }
    $4 == "input" && (o == "" || $2 < o) { o = $2 }
    END { print g, c["input"]+0, c["running"]+0, c["done"]+0, t - c["input"] - c["running"] - c["done"], o+0 }' >"$s/sum.$$" &&
    mv "$s/sum.$$" "$s/sum"
}

# list [cached]: the rows for fzf; cached draws a frame from the panel's copy.
list() {
  local rows now cols
  if [ "${1:-}" = cached ]; then rows="$(cat "$AGENTS_STATE/rows")"
  else rows="$(rows)"; [ -z "${AGENTS_STATE:-}" ] || keep "$rows"; fi
  now="$(date +%s)"

  # Status, agent, age and gaps are fixed; the title gets what's left after
  # the project's third (up to 22 columns), up to 36.
  panel_cols
  local tw pw aw rw cell
  widths

  if [ -z "$rows" ]; then
    printf -- '-\t%s  no agents yet. Start claude, copilot or pi in any pane.%s\n' "$DIM" "$R"
    return
  fi

  # A group heading: the session's name at the row's left edge, a faint rule,
  # then a count per state in its colour, ending where the age column does.
  # The rule keeps two bars; the name is cut with … to fit, and the counts go
  # when even that won't. The floor keeps every cut non-negative on an
  # absurdly narrow panel.
  local hw=$rw bars s n ns i counts cl gl=(▲ ✓ zᶻ ●) gc=("$AMBER" "$GREEN" "$DIM" "$BLUE") ri=0
  [ "$hw" -le "$cols" ] || hw=$cols
  hw=$(( hw - 1 ))
  [ "$hw" -ge 5 ] || hw=5
  printf -v bars '%*s' "$hw" ''; bars="${bars// /─}"
  while IFS="$US" read -r rank since id st agent proj title sess; do
    local glyph col who='' ago where=''
    if [ "$rank" = H ]; then
      read -r -a ns <<<"$st"
      counts='' cl=0
      for i in 0 1 2 3; do
        [ "${ns[i]}" -gt 0 ] || continue
        counts+=" ${gc[i]}${gl[i]}${ns[i]}$R"; cl=$(( cl + 1 + ${#gl[i]} + ${#ns[i]} ))
      done
      n=$(( hw - cl - 3 ))
      [ "$n" -ge 2 ] || { counts='' cl=0 n=$(( hw - 3 )); }
      s="$sess"; [ "${#s}" -le "$n" ] || s="${s:0:n-1}…"
      printf -- '%s\t %s%s%s%s %s%s%s%s\t%s\n' "$id" "$B" "$TEXT" "$s" "$UB$R" "$FAINT" "${bars:0:hw-${#s}-1-cl}" "$R" "$counts" "$sess"
      continue
    fi
    case "$st" in
      input)   glyph='▲ ' col=$AMBER ;;
      running) glyph='● ' col=$BLUE  ;;
      done)    glyph='✓ ' col=$GREEN ;;
      *)       glyph='zᶻ' col=$DIM   ;;
    esac
    [ "$pw" -gt 0 ] && { fit cell "$pw" "$proj"; where=" $DIM$cell$R"; }
    [ "$aw" -gt 0 ] && { fit cell "$aw" "$agent"; who=" $DIM$cell$R"; }
    fit cell "$tw" "$title"; age ago "$since"
    if [ "$st" = running ] && [ -n "${AGENTS_STATE:-}" ]; then
      # Each working row on its own phase, so two never move in step.
      glyph=${WAVE[(frame + ri * 3) % 8]}
      shine cell "$cell" $(( (frame + ri * 11) % (tw + 12) - 6 ))
    else cell="$TEXT$cell$R"; fi
    ri=$(( ri + 1 ))
    printf '%s\t %s%s%s %s%s%s %s%4s%s\t%s\n' \
      "$id" \
      "$col" "$glyph" "$R" \
      "$cell" \
      "$where" \
      "$who" \
      "$DIM" "$ago" "$R" \
      "$title"
  done <<<"$rows"
}

# bar <state> <cells>: sets bar, a run of ━ in the state's colour. Working
# carries a shine that sweeps along it; needs you breathes ($PULSE).
bar() {
  local i c last='' base=$BLUE sh
  bar=''
  case "$1" in
    (running)
      sh=$(( frame * 2 % ($2 + 8) - 4 ))
      for (( i = 0; i < $2; i++ )); do band $(( i - sh )); [ "$c" = "$last" ] || { bar+=$c; last=$c; }; bar+='━'; done ;;
    (*) case "$1" in (input) c=$PULSE ;; (done) c=$GREEN ;; (*) c=$FAINT ;; esac
        printf -v bar '%*s' "$2" ''; bar="$c${bar// /━}" ;;
  esac
  bar+=$R
}

# header: the summary over the list, from the panel's counts. With room, one
# bar with a segment per state over a line of counts; when that line won't
# fit, a stack: a line per state, each with its own bar. A state with no
# agents sits dim, and needs you breathes only while someone waits.
header() {
  local gen nin nrun ndone nidle old line vis ago='' ic rc dc all='' k cells seg tot cols e=$'\033'
  read -r gen nin nrun ndone nidle old 2>/dev/null <"$AGENTS_STATE/sum" || { printf ' '; return; }
  now="$(date +%s)"; panel_cols; pulse
  tot=$(( nin + nrun + ndone + nidle ))
  ic=$DIM rc=$DIM dc=$DIM
  [ "$nin" -gt 0 ] && { ic=$PULSE; age ago "$old"; }
  [ "$nrun" -gt 0 ] && rc=$BLUE
  [ "$ndone" -gt 0 ] && dc=$GREEN
  printf -v line ' %s▲ %s%s%s need you   %s● %s%s%s working   %s✓ %s%s%s done   %szᶻ %s idle%s' \
    "$ic" "$B" "$nin" "$UB" "$rc" "$B" "$nrun" "$UB" "$dc" "$B" "$ndone" "$UB" "$DIM" "$nidle" "$R"
  [ -z "$ago" ] || line+="   ${DIM}oldest wait ${AMBER}${ago}${R}"
  vis="${line//$e\[+([0-9;])m/}"

  if [ "${#vis}" -le "$cols" ]; then
    for k in input running done idle; do
      case $k in (input) cells=$nin ;; (running) cells=$nrun ;; (done) cells=$ndone ;; (*) cells=$nidle ;; esac
      [ "$cells" -gt 0 ] || continue
      seg=$(( cells * cols / tot )); [ "$seg" -ge 1 ] || seg=1
      bar "$k" "$seg"; all+=$bar
    done
    [ "$tot" -gt 0 ] && printf ' %s\n' "$all"
    printf '%s' "$line"
    return 0
  fi

  local bw=$(( cols - 22 )) lbl gl c tail
  [ "$bw" -ge 4 ] || bw=4
  for k in input running done idle; do
    case $k in
      (input)   cells=$nin   lbl='need you' gl='▲ ' c=$ic ;;
      (running) cells=$nrun  lbl='working'  gl='● ' c=$rc ;;
      (done)    cells=$ndone lbl='done'     gl='✓ ' c=$dc ;;
      (*)       cells=$nidle lbl='idle'     gl='zᶻ' c=$DIM ;;
    esac
    tail=''; [ "$k" = input ] && [ -n "$ago" ] && tail=" ${AMBER}${ago}${R}"
    if [ "$cells" -gt 0 ]; then
      seg=$(( cells * bw / tot )); [ "$seg" -ge 1 ] || seg=1
      bar "$k" "$seg"
    else bar="${FAINT}·${R}"; fi
    printf ' %s%s %-9s%s%s%2s%s  %s%s' "$c" "$gl" "$lbl" "$R" "$B$c" "$cells" "$R" "$bar" "$tail"
    [ "$k" = idle ] || printf '\n'
  done
}

# A row id is a pane id; the empty-state row uses "-". (fzf 0.74 hangs on
# --track after a reload when the tracked row's id field is empty.)
is_pane() { case "${1:-}" in %*) return 0 ;; esac; return 1; }

# With "stay" (the docked panel), the panel moves to the agent's window in the
# same tmux call as the switch, so the switch hooks find it already there and
# tmux draws only the end result. It then takes focus back: the agent is that
# window's last pane. Where the panel can't follow (a zoomed or narrow window)
# the agent keeps focus. Either way the focus hook may not fire on the agent,
# so mark a finished one seen here, once the switch is drawn.
jump() {
  is_pane "${1:-}" || return 0
  local go=(switch-client -t "$1" \; select-window -t "$1" \; select-pane -t "$1") dock
  [ "${2:-}" = stay ] || { tmux "${go[@]}"; return 0; }
  dock="$(tmux show -gv @agents_dock 2>/dev/null)" && go+=(\; select-pane -t "$dock")
  "${self%/*}/agents-dock" follow "$(tmux display -p -t "$1" '#{window_id}')" "${go[@]}" ||
    { [ $? = 2 ] && tmux display-message "agents: the panel could not follow"; }
  "${self%/*}/agent-state" seen "$1"
}

# Only an agent that is actually waiting gets keystrokes; anywhere else an
# Enter or Escape lands in whatever happens to be on screen.
waiting() { [ "$(tmux display -p -t "$1" '#{@agent_state}' 2>/dev/null)" = input ]; }

approve() {
  is_pane "${1:-}" && waiting "$1" || { tmux display-message "agents: that one isn't waiting for you"; return 0; }
  tmux send-keys -t "$1" Enter
}

# Escape (C-c for Copilot) stops a working agent; on a prompt it would dismiss
# the question, so only a working agent gets it.
interrupt() {
  is_pane "${1:-}" || return 0
  [ "$(tmux display -p -t "$1" '#{@agent_state}' 2>/dev/null)" = running ] ||
    { tmux display-message "agents: that one isn't working"; return 0; }
  # Copilot ignores a sent Escape. Neither its cancel nor Claude's Escape
  # fires a hook, so mark the agent idle here: it would read working until
  # the next prompt, and for Copilot a second x would send the C-c that quits it.
  local agent; agent="$(tmux display -p -t "$1" '#{@agent}' 2>/dev/null)"
  adapter "$agent" || true
  tmux send-keys -t "$1" "$INTERRUPT"
  TMUX_PANE="$1" "${self%/*}/agent-state" idle "$agent" </dev/null
}

# message PANE TEXT: type TEXT into the agent and press Enter. Fails when the
# pane is gone.
message() {
  is_pane "${1:-}" || return 0
  local msg="${2:-}"
  [ -n "$msg" ] || return 0
  tmux send-keys -t "$1" -l -- "$msg" && tmux send-keys -t "$1" Enter
}

# rename PANE [NAME]: the name shows in place of the agent's own title until
# the pane closes or the agent ends; an empty name hands the row back to that
# title. Fails when the pane is gone.
rename() {
  is_pane "${1:-}" || return 0
  if [ -n "${2:-}" ]; then tmux set -p -t "$1" @agent_name "$2"
  else tmux set -pu -t "$1" @agent_name
  fi
}

# kill_pane PANE: closes the agent's pane, and its window or session with it
# when it was the last. Fails when the pane is gone.
kill_pane() {
  is_pane "${1:-}" || return 0
  tmux kill-pane -t "$1"
}

# rename_session SESSION NAME: prints the name tmux took (before 3.6 or so
# it swaps : and . for _). A session can't go nameless, so an empty name fails, as do a taken
# one and a gone session, with tmux's reason on stderr.
rename_session() {
  [ -n "${2:-}" ] || { echo 'no name' >&2; return 1; }
  local id
  # display prints nothing, and succeeds, for a gone session; an empty -t
  # would rename the current one.
  id="$(tmux display -p -t "=$1:" '#{session_id}' 2>/dev/null)"
  [ -n "$id" ] || { echo "can't find session: $1" >&2; return 1; }
  tmux rename-session -t "$id" -- "$2" && tmux display -p -t "$id:" '#{session_name}'
}

# / opens the filter and locks the action keys ($AGENTS_LOCK) so they type;
# in it, / types a /, and a second / within 0.4s clears and closes it. fzf
# drops a query change that leaves one transform together with hide-input, so
# closing takes two: this clears the query, then key shut hides the field. In
# a field / just types.
slash() {
  local s="$AGENTS_STATE" now last=0
  now="$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null)" || now=$(( $(date +%s) * 1000 ))
  if [ "${FZF_INPUT_STATE:-hidden}" = hidden ]; then
    echo "$now" >"$s/slash"
    printf 'unbind(%s)+change-input-label( filter )+show-input' "$AGENTS_LOCK"; return
  fi
  [ "$FZF_PROMPT" = '⌕ ' ] || { printf 'put(/)'; return; }
  read -r last 2>/dev/null <"$s/slash" || true
  if [ $(( now - last )) -lt 400 ]; then rm -f "$s/slash"; : >"$s/shut"; printf 'change-query()'
  else echo "$now" >"$s/slash"; printf 'put(/)'; fi
}

# m and n turn fzf's own input line into a field for the selected agent, so
# the panel never leaves the screen. fzf runs key for each step ($AGENTS_* set
# by panel):
#   key m|n PANE            open the field, on an agent's row only; n also
#                           on a group heading, to rename its session
#   key message|rename SHOWN  the prompt, naming the agent, cut for the dock
#   key d PANE              ask, in the footer, before killing an agent's pane
#   key kill SHOWN          that question, naming the agent, cut for the dock
#   key enter PANE SHOWN    send, rename or kill, then say in the footer how it went,
#                           put back by key restore 3s later; elsewhere, jump
#   key esc                 leave the field, or close the panel
#   key first               on opening grouped, start on the first agent, not its heading
#   key reload              the refresh, held while a field is open so the
#                           row being written to stays the selected one
#   key slash, key shut     / and its second half: see slash
# Closing the field is chained after key in the bind: fzf drops a clear-query
# that comes out of a transform, and the query would go on filtering the list.
key() {
  local did=''
  case "$1:$FZF_PROMPT" in
    slash:*)              slash; return ;;
    shut:*)               if [ -f "$AGENTS_STATE/shut" ]; then rm -f "$AGENTS_STATE/shut"; printf 'hide-input+rebind(%s)+search()' "$AGENTS_LOCK"; fi
                          return 0 ;;
    m:*|n:*)              is_pane "${2:-}" || case "$1:${2:-}" in (n:-?*) ;; (*) return 0 ;; esac
                          if [ "$1" = m ]; then printf '%s' "$AGENTS_M"; else printf '%s' "$AGENTS_N"; fi
                          return ;;
    d:*)                  is_pane "${2:-}" || return 0
                          printf '%s' "$AGENTS_D"; return ;;
    kill:*)               local n="${2:-}"; [ "${#n}" -le 24 ] || n="${n:0:23}…"
                          printf '%skill %s?%s  %s↵%s yes  %sesc%s no%s' "$TEXT" "$n" "$R" "$B$TEXT" "$UB$DIM" "$B$TEXT" "$UB$DIM" "$R"
                          return ;;
    message:*|rename:*)   local n="${2:-}"; [ "${#n}" -le 24 ] || n="${n:0:23}…"
                          printf '%s %s › ' "${1/message/message to}" "$n"
                          return ;;
    'enter:message to '*) if [ -z "$FZF_QUERY" ]; then :
                          elif message "$2" "$FZF_QUERY" 2>/dev/null; then did="${GREEN}✓${R} sent to $TEXT$3"
                          else did="${AMBER}✗${R} not sent: $TEXT$3$R is gone"; fi ;;
    'enter:kill'*)        if kill_pane "$2" 2>/dev/null; then did="${GREEN}✓${R} killed $TEXT$3"
                          else did="${AMBER}✗${R} not killed: $TEXT$3$R is gone"; fi ;;
    'enter:rename '*)     local out
                          if [ "$FZF_QUERY" = "$3" ]; then :
                          elif ! is_pane "$2"; then
                            if [ -z "$FZF_QUERY" ]; then :
                            elif out="$(rename_session "$3" "$FZF_QUERY" 2>&1)"; then did="${GREEN}✓${R} renamed to $TEXT$out"
                            else did="${AMBER}✗${R} not renamed: $TEXT$out"; fi
                          elif ! rename "$2" "$FZF_QUERY" 2>/dev/null; then did="${AMBER}✗${R} not renamed: $TEXT$3$R is gone"
                          elif [ -n "$FZF_QUERY" ]; then did="${GREEN}✓${R} renamed to $TEXT$FZF_QUERY"
                          else did="${GREEN}✓${R} name reset"; fi ;;
    enter:*)              printf '%s' "$AGENTS_ENTER"; return ;;
    esc:'⌕ ')             [ "${FZF_INPUT_STATE:-hidden}" != hidden ] || { printf abort; return; } ;;
    reload:'⌕ ')          printf 'reload-sync(%s --list0)' "$self"; return ;;
    first:*)              [ "$(tmux show -gv @agents_group 2>/dev/null)" = on ] && printf 'pos(2)'; return 0 ;;
    restore:'⌕ ')         ;;
    restore:*|reload:*)   return ;;
  esac
  if [ -n "$did" ]; then
    printf 'execute-silent[(sleep 3; curl -fs -XPOST localhost:$FZF_PORT -d %s) >/dev/null 2>&1 &]' "'transform:$self --key restore'"
    printf '+change-footer:%s' "$did$R"
  else printf 'change-footer:%s' "$AGENTS_FOOTER"
  fi
}

# The summary's title shows whether the panel has focus: dim without it. On
# gaining it, a light gold shine sweeps the title left to right, two letters
# a frame, leaving "agent-" bright and "corral" gold behind it. The focus
# hooks in agents.tmux ping the docked panel (--ping), which redraws the
# title from the real focus, so a lost ping or a quick out-and-back (↵ in the
# dock) leaves it right. The popup is always in front. $AGENTS_STATE/lit
# marks a sweep played for this focus, shimmer the frame it began on.
label() {
  local s="${AGENTS_STATE:-}" t='agent-corral' i d c out='' p=99 start
  if [ -z "${AGENTS_SIDE:-}" ] && [ "$(tmux display -p -t "$TMUX_PANE" '#{&&:#{pane_active},#{window_active}}')" != 1 ]; then
    [ -z "$s" ] || rm -f "$s/lit" "$s/shimmer"
    printf ' %s%s%s ' "$DIM" "$t" "$R"; return
  fi
  if [ -n "$s" ] && [ -n "$GOLD" ]; then
    [ -f "$s/lit" ] || { : >"$s/lit"; echo "$frame" >"$s/shimmer"; }
    if read -r start 2>/dev/null <"$s/shimmer"; then
      p=$(( (frame - start) * 2 - 2 ))
      [ "$p" -le $(( ${#t} + 1 )) ] || { rm -f "$s/shimmer"; p=99; }
    fi
  fi
  for (( i = 0; i < ${#t}; i++ )); do
    d=$(( i - p ))
    if [ "$p" = 99 ] || [ "$d" -lt -1 ]; then
      if [ "$i" -lt 6 ]; then c=$LIT; else c=$GOLD; fi
    elif [ "$d" = 0 ]; then c=$GOLD1
    elif [ "$d" -le 1 ]; then c=$GOLD2
    else c=$DIM; fi
    out+="$c${t:i:1}"
  done
  printf ' %s%s%s%s ' "$B" "$out" "$UB" "$R"
}

# The ping leaves a mark that the panel's next tick turns into a redraw: fzf
# drops some actions posted to its port while every() is running.
ping() {
  local dock dir
  dock="$(tmux show -gv @agents_dock 2>/dev/null)" || return 0
  dir="$(tmux display -p -t "$dock" '#{@agents_state}' 2>/dev/null)"
  [ -z "$dir" ] || [ ! -d "$dir" ] || : >"$dir/label"
}

# keymap: the panel's action keys, in footer order: action, key, the popup's
# hint, the dock's (- for none). @agents_panel_key_<action> moves one; an
# empty one is left out, unbound. fzf splits its lists on , and its binds on
# :, so a key with either keeps its default (the doctor says so).
keymap() {
  local k v
  while read -r -a k; do
    if v="$(tmux show -gv "@agents_panel_key_${k[0]}" 2>/dev/null)"; then
      case "$v" in *[,:]*) ;; *) k[1]="$v" ;; esac
    fi
    [ -z "${k[1]}" ] || printf '%s %s %s %s\n' "${k[@]}"
  done <<'KEYS'
approve   y approve   approve
message   m message   msg
rename    n rename    name
interrupt x interrupt stop
kill      d kill      kill
new       c new       -
group     g group     -
preview   p preview   peek
close     q close     close
reload    r -         -
down      j -         -
up        k -         -
KEYS
}

panel() {
  command -v fzf >/dev/null 2>&1 || die "fzf not found (brew install fzf)"
  local watch="${1:-}" enter new preview hint_col=2 start=''   # keymap's column of hints
  # The docked panel is narrow, so its key hints are shorter, and fewer.
  if [ "$watch" = watch ]; then
    start="execute-silent(tmux set -p -t \$TMUX_PANE @agents_state \$AGENTS_STATE)+"
    enter="execute-silent($self --jump {1} stay)"
    new="execute(${self%/*}/agents-new stay)+reload-sync($self --list0)"
    preview='down,40%,follow,border-rounded'
    hint_col=3
  else
    export AGENTS_SIDE=1
    enter="become($self --jump {1})"
    new="become(${self%/*}/agents-new)"
    preview='right,55%,follow,border-rounded'
  fi
  AGENTS_STATE="$(mktemp -d "${TMPDIR:-/tmp}/agent-corral.XXXXXX")"
  trap 'rm -rf "$AGENTS_STATE"' EXIT
  # shellcheck disable=SC2154   # palette sets pal: what tmux said
  export AGENTS_STATE AGENTS_PAL="$pal"
  local label='case {1} in %*) tmux display -p -t {1} " #{session_name}:#{window_index}.#{pane_index}  #{pane_current_path} " ;; esac'

  # The binds, footer and the lock below all come from keymap. The footer's
  # hints wrap to a second line rather than run off a narrow panel.
  local a k hint footer='' fl=0 fw lock='' binds=()
  fw="$( (stty size </dev/tty) 2>/dev/null || true)"; fw=$(( ${fw#* } + 0 - 6 ))
  [ "$fw" -gt 0 ] || fw=200
  addhint() {
    local n=$(( ${#1} + ${#2} + 3 ))
    if [ "$fl" -gt 0 ] && [ $(( fl + n - 2 )) -gt "$fw" ]; then footer="${footer%  }"$'\n'; fl=0; fi
    footer+="$B$TEXT$1$UB$DIM $2  "; fl=$(( fl + n ))
  }
  addhint ↵ jump; addhint / filter
  while read -r -a k; do
    a="${k[0]}"
    case "$a" in
      approve)   binds+=(--bind="${k[1]}:execute-silent($self --approve {1})+reload-sync($self --list0)") ;;
      message)   binds+=(--bind="${k[1]}:transform($self --key m {1})") ;;
      rename)    binds+=(--bind="${k[1]}:transform($self --key n {1})") ;;
      interrupt) binds+=(--bind="${k[1]}:execute-silent($self --interrupt {1})") ;;
      kill)      binds+=(--bind="${k[1]}:transform($self --key d {1})") ;;
      new)       binds+=(--bind="${k[1]}:$new") ;;
      group)     binds+=(--bind="${k[1]}:execute-silent($self --group)+reload-sync($self --list0)") ;;
      preview)   binds+=(--bind="${k[1]}:toggle-preview+transform-preview-label:$label") ;;
      close)     binds+=(--bind="${k[1]}:abort") ;;
      reload)    binds+=(--bind="${k[1]}:reload-sync($self --list0)") ;;
      down|up)   binds+=(--bind="${k[1]}:$a") ;;
    esac
    lock+="${k[1]},"
    hint="${k[hint_col]}"
    [ "$hint" = - ] || addhint "${k[1]}" "$hint"
  done < <(keymap)

  # Refresh through fzf's own HTTP port: at once when agent-state signals the
  # agents channel, and every 10s for the ages, after a sweep for agents that
  # died without a word. Each loop ends on its first reload after fzf has gone.
  local sweep="'${self%/*}/agent-state' sweep"
  local reload="curl -fs -XPOST localhost:\$FZF_PORT -d 'transform:$self --key reload'"
  local tick="(while sleep 10 && $sweep && $reload; do :; done) >/dev/null 2>&1 & (while tmux wait-for agents && $reload; do :; done) >/dev/null 2>&1 &"

  # While the filter is open the action keys type. While a field is, ↑↓ stay
  # put too, so the row being written to can't change underneath.
  export AGENTS_LOCK="${lock%,}"
  lock+='up,down'
  local open="unbind($lock)+disable-search+change-input-label()+show-input+change-footer(${DIM}↵ send  esc cancel${R})"
  local close="+clear-query+enable-search+hide-input+change-prompt(⌕ )+change-input-label( filter )+rebind($lock)+reload-sync($self --list0)"
  export AGENTS_ENTER="$enter" AGENTS_FOOTER="${footer%  }" \
    AGENTS_M="$open+change-query()+transform-prompt($self --key message {3})" \
    AGENTS_N="$open+transform-query(printf %s {3})+transform-prompt($self --key rename {3})" \
    AGENTS_D="unbind($lock)+disable-search+change-prompt(kill › )+transform-footer($self --key kill {3})"

  # The first list loads through reload so it, too, sees $FZF_COLUMNS.
  # shellcheck disable=SC2154   # palette sets the colours
  fzf </dev/null \
    --ansi --read0 --no-input --no-sort --layout=reverse --cycle \
    --delimiter=$'\t' --with-nth=2 --id-nth=1 --track \
    --listen --bind "start:${start}transform-header-label($self --label)+execute-silent($sweep)+reload-sync($self --list0)+execute-silent:$tick" \
    --bind "every(0.2):bg-transform($self --tick)" \
    --bind "load:transform($self --key first)+unbind(load)" \
    --bind "resize:transform($self --key reload)" \
    --header=' ' --header-first --header-border=rounded --header-label=' agent-corral ' --header-label-pos=0 \
    --input-border=rounded --input-label=' filter ' --input-label-pos=3 --prompt='⌕ ' \
    --list-border=rounded --list-label=' agents ' --list-label-pos=3 \
    --info=hidden --pointer='▌' --gutter=' ' --highlight-line \
    --footer="${footer%  }" \
    --footer-border=none \
    --preview='case {1} in %*) tmux capture-pane -pe -J -t {1} -S -80 | awk "{l[NR]=\$0} NF{n=NR} END{for(i=1;i<=n;i++)print l[i]}" ;; esac' \
    --preview-window="$preview" \
    --bind="focus:transform-preview-label:$label" \
    --color="fg:$tc,bg:$bgc,fg+:255,bg+:236,hl:$bc,hl+:$bc" \
    --color="border:$fc,label:$bc,preview-border:$fc,preview-label:$dc,footer-border:$fc" \
    --color="list-border:$fc,header-border:$fc,input-border:$fc,list-label:$dc,input-label:$dc" \
    --color="pointer:$bc,marker:$bc,gutter:-1,info:$dc,header:$tc" \
    --color="prompt:$bc,query:255" \
    --bind="enter:transform($self --key enter {1} {3})$close" \
    --bind="esc:transform($self --key esc)$close" \
    --bind="/:transform($self --key slash)+transform($self --key shut)" \
    ${binds[@]+"${binds[@]}"} \
    >/dev/null || true
  # Wake this panel's waiter so it sees fzf gone and exits now, not on the
  # next state change; any other open panel just reloads once.
  tmux wait-for -S agents 2>/dev/null || true
}

# nul: --list as the panel reads it. Every group heading but the first gets
# a blank line above it, inside its own item, so the gap before each group is
# no row j and k have to stop on.
nul() { awk 'NR > 1 && /^-[^\t]/ { sub(/\t/, "\t\037") } 1' | tr '\n\037' '\0\n'; }

case "${1:-}" in
  '')          panel ;;
  --watch)     panel watch ;;
  --list)      list ;;
  --list0)     list | nul ;;
  --frame)     list cached | nul ;;
  --header)    header ;;
  --rows)      rows | tr "$US" '\t' ;;
  --keys)      keymap ;;
  --label)     label ;;
  --ping)      ping ;;
  --jump)      jump "${2:-}" "${3:-}" ;;
  --approve)   approve "${2:-}" ;;
  --interrupt) interrupt "${2:-}" ;;
  --message)   shift; message "$@" ;;
  --rename)    shift; rename "$@" ;;
  --key)       shift; key "$@" ;;
  # g: flip grouping, and wake every open panel so popup and dock agree.
  --group)     tmux set -gF @agents_group '#{?#{==:#{@agents_group},on},off,on}' \; wait-for -S agents ;;
  *)           die "usage: $(basename "$0") [--watch|--list]" ;;
esac
